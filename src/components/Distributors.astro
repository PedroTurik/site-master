---
import Icon from './Icon.astro';
import { distributors } from '../data/manufacturers';
import { type Lang, url } from '../i18n/routes';

interface Props { lang: Lang; heading?: 'h1' | 'h2'; showSteps?: boolean; showLink?: boolean; }
const { lang, heading = 'h2', showSteps = true, showLink = true } = Astro.props;
const H = heading;
const c = {
  pt: {
    label: 'Distribuidores parceiros',
    title: 'Compre com a segurança dos maiores distribuidores do mundo.',
    p: 'Somos parceiros estratégicos da Arrow Electronics, Future Electronics, Macnica DHW e Richardson RFPD, disponibilizando os produtos dos fabricantes que representamos por meio desses distribuidores globais e garantindo soluções logísticas integradas com suporte técnico especializado.',
    visit: 'Visitar site',
    stepsTitle: 'Como comprar',
    steps: [
      { t: 'Fale com a Mastertronics', d: 'Nossa equipe apoia a especificação técnica e comercial da sua aplicação.' },
      { t: 'Indicamos o canal ideal', d: 'Informamos quais linhas de produtos sua empresa pode adquirir através de cada distribuidor parceiro.' },
      { t: 'Compre com logística global', d: 'Você compra pelo distribuidor, com estoque, logística integrada e o nosso suporte técnico.' },
    ],
    more: 'Saiba como funciona',
  },
  en: {
    label: 'Distribution partners',
    title: 'Buy with the confidence of the world’s largest distributors.',
    p: 'We are strategic partners of Arrow Electronics, Future Electronics, Macnica DHW and Richardson RFPD, making our manufacturers’ products available through these global distributors and ensuring integrated logistics solutions with specialized technical support.',
    visit: 'Visit website',
    stepsTitle: 'How to buy',
    steps: [
      { t: 'Talk to Mastertronics', d: 'Our team supports the technical and commercial specification of your application.' },
      { t: 'We point you to the right channel', d: 'We tell you which product lines your company can purchase from each distribution partner.' },
      { t: 'Buy with global logistics', d: 'You purchase through the distributor, with stock, integrated logistics and our technical support.' },
    ],
    more: 'See how it works',
  },
}[lang];
---
<section class="dsec" id="distribuidores">
  <div class="container">
    <div class="dhead">
      <div>
        <span class="label reveal">{c.label}</span>
        <H class="h2 reveal" style="--d:.05s">{c.title}</H>
      </div>
      <p class="lead reveal" style="--d:.1s">{c.p}</p>
    </div>

    <ul class="dgrid">
      {distributors.map((d, i) => (
        <li class="reveal" style={`--d:${i * 0.06}s`}>
          <a href={d.href} target="_blank" rel="noopener" class="dcard">
            <span class="dlogo"><img src={d.logo} alt={d.name} loading="lazy" /></span>
            <span class="dbody">
              <strong>{d.name}</strong>
              <span>{d.about[lang]}</span>
            </span>
            <span class="dvisit mono">{c.visit}<Icon name="arrow-ur" size={14} /></span>
          </a>
        </li>
      ))}
    </ul>

    {showSteps && (
      <div class="dsteps reveal">
        <p class="dsteps-h mono">{c.stepsTitle}</p>
        <ol>
          {c.steps.map((s, i) => (
            <li>
              <span class="dn mono">0{i + 1}</span>
              <div><strong>{s.t}</strong><span>{s.d}</span></div>
            </li>
          ))}
        </ol>
        {showLink && <a href={url(lang, 'distributors')} class="btn btn--primary btn--sm dmore">{c.more}<Icon name="arrow" /></a>}
      </div>
    )}
  </div>
</section>

<style>
  .dsec { background: var(--white); border-top: 1px solid var(--line); padding-block: var(--section); }
  .dhead { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(32px, 6vw, 96px); align-items: end; margin-bottom: clamp(40px, 5vw, 64px); }
  .dhead > div { display: grid; gap: 18px; }
  .dhead .lead { font-size: 1.0625rem; }
  @media (max-width: 900px) { .dhead { grid-template-columns: 1fr; } }

  .dgrid { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .dcard {
    display: grid; grid-template-rows: auto 1fr auto; height: 100%; border-radius: 18px; overflow: hidden;
    border: 1px solid var(--line); background: var(--white);
    transition: border-color .35s, box-shadow .35s, transform .35s var(--ease);
  }
  .dcard:hover { border-color: var(--line-strong); box-shadow: var(--shadow-2); transform: translateY(-3px); }
  .dlogo { display: grid; place-items: center; height: 168px; padding: 28px; background: var(--paper); border-bottom: 1px solid var(--line); }
  .dlogo img { max-height: 64px; max-width: 86%; object-fit: contain; transition: transform .5s var(--ease); }
  .dcard:hover .dlogo img { transform: scale(1.05); }
  .dbody { display: grid; gap: 6px; align-content: start; padding: 20px 22px 8px; }
  .dbody strong { font-family: var(--font-display); font-weight: 600; font-size: 1.125rem; letter-spacing: -.02em; }
  .dbody span { font-size: .875rem; color: var(--slate); line-height: 1.55; }
  .dvisit { display: inline-flex; align-items: center; gap: 6px; padding: 12px 22px 20px; font-size: .6875rem; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); transition: color .3s; }
  .dcard:hover .dvisit { color: var(--ink); }
  @media (max-width: 1060px) { .dgrid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .dgrid { grid-template-columns: 1fr; } .dlogo { height: 130px; } }

  .dsteps { margin-top: 20px; display: grid; grid-template-columns: 130px 1fr auto; gap: 28px; align-items: start; padding: 26px 28px; border-radius: 18px; background: var(--ink); color: var(--on-dark); }
  .dsteps-h { padding-top: 2px; font-size: .75rem; text-transform: uppercase; letter-spacing: .07em; color: var(--lime); }
  .dsteps ol { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .dsteps li { display: grid; grid-template-columns: auto 1fr; gap: 12px; }
  .dn { font-size: .75rem; color: var(--on-dark-muted); padding-top: 3px; }
  .dsteps li div { display: grid; gap: 4px; align-content: start; }
  .dsteps strong { font-weight: 600; font-size: .9375rem; color: #fff; }
  .dsteps li span:not(.dn) { font-size: .8125rem; color: var(--on-dark-muted); line-height: 1.5; }
  .dmore { align-self: center; background: var(--lime); color: var(--ink); }
  .dmore:hover { background: #ebea5a; }
  @media (max-width: 1060px) { .dsteps { grid-template-columns: 1fr; } .dmore { justify-self: start; } }
  @media (max-width: 700px) { .dsteps ol { grid-template-columns: 1fr; } }
</style>
