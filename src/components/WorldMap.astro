---
// Dot-matrix world map with animated trace arcs flowing from manufacturer regions and the China HUB into Porto Alegre.
import world from '../data/world-dots.json';

interface Node { id: string; label: string; lon: number; lat: number; kind?: 'hq' | 'hub' | 'mfr'; }
// `route` marks the hub arc as the logistics route (China HUB → HQ) and labels it south of the Cape.
interface Props { nodes: Node[]; class?: string; theme?: 'dark' | 'light'; labelScale?: number; route?: string; }
const { nodes, class: cls = '', theme = 'dark', labelScale = 1, route } = Astro.props;

const K = 10; // px per degree
const W = (world.lonMax - world.lonMin) * K;
const H = (world.latMax - world.latMin) * K;
const x = (lon: number) => (lon - world.lonMin) * K;
const y = (lat: number) => (world.latMax - lat) * K;

type P = [number, number];
const bez = (p: P[], t: number): P => {
  const u = 1 - t;
  return [0, 1].map((k) => u * u * u * p[0][k] + 3 * u * u * t * p[1][k] + 3 * u * t * t * p[2][k] + t * t * t * p[3][k]) as P;
};

const hq = nodes.find((n) => n.kind === 'hq')!;
// Every arc flows into HQ (technology and supplies come to Brazil). Arcs from Asia take the sea
// route south of the Cape of Good Hope, so nothing reads as crossing (or stopping in) Africa.
const arcs = nodes
  .filter((n) => n.kind !== 'hq')
  .map((n, i) => {
    const hub = n.kind === 'hub';
    const isRoute = hub && !!route;
    const pts: P[] = n.lon > 40
      ? [[n.lon, n.lat], [n.lon - 6, -52], [12, -64], [hq.lon, hq.lat]]
      : (() => {
          const mx = (n.lon + hq.lon) / 2, my = (n.lat + hq.lat) / 2;
          const c: P = [mx, my + Math.hypot(hq.lon - n.lon, hq.lat - n.lat) * 0.32];
          return [[n.lon, n.lat], c, c, [hq.lon, hq.lat]];
        })();
    const [p0, p1, p2, p3] = pts.map(([lon, lat]) => [x(lon), y(lat)]);
    const d = `M${p0} C${p1} ${p2} ${p3}`;
    // Route label sits south of the Cape, with a chevron pointing along the path towards Brazil.
    const [ax, ay] = bez(pts, 0.66).map((v, k) => (k ? y(v) : x(v)));
    const [bx, by] = bez(pts, 0.68).map((v, k) => (k ? y(v) : x(v)));
    const label = { x: ax, y: ay, angle: (Math.atan2(by - ay, bx - ax) * 180) / Math.PI };
    return { d, i, hub, isRoute, label };
  });
const routeArc = arcs.find((a) => a.isRoute);
const r = world.step * K * 0.2;
---
<div class:list={['wmap', `wmap--${theme}`, cls]} aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid meet">
    <defs>
      <radialGradient id="wm-glow">
        <stop offset="0" stop-color="var(--lime)" stop-opacity=".55" />
        <stop offset="1" stop-color="var(--lime)" stop-opacity="0" />
      </radialGradient>
    </defs>
    <g class="wmap-dots">
      {world.dots.map(([lon, lat]) => <circle cx={x(lon)} cy={y(lat)} r={r} />)}
    </g>
    <g class="wmap-arcs">
      {arcs.map((a) => (
        <>
          <path class="wmap-arc-base" d={a.d} />
          <path class:list={['wmap-arc', a.hub && 'is-hub', a.isRoute && 'is-route']} d={a.d} pathLength="1" style={`--i:${a.i}`} />
        </>
      ))}
    </g>
    {routeArc && (
      <g class="wmap-route" transform={`translate(${routeArc.label.x} ${routeArc.label.y})`}>
        <path class="wmap-route-mark" d="M-6,-9 L4,0 L-6,9" transform={`rotate(${routeArc.label.angle})`} />
        <text y={-30 * labelScale} text-anchor="middle" style={`font-size:${26 * labelScale}px`}>{route}</text>
      </g>
    )}
    <g class="wmap-nodes">
      {nodes.map((n, i) => (
        <g class:list={['wmap-node', `is-${n.kind ?? 'mfr'}`]} transform={`translate(${x(n.lon)} ${y(n.lat)})`} style={`--i:${i}`}>
          {n.kind !== 'mfr' && <circle class="wmap-halo" r="46" fill="url(#wm-glow)" />}
          <circle class="wmap-ring" r={n.kind === 'mfr' ? 9 : 14} />
          <circle class="wmap-core" r={n.kind === 'mfr' ? 4.5 : 7} />
        </g>
      ))}
    </g>
    <g class="wmap-labels">
      {nodes.filter((n) => n.kind !== 'mfr').map((n) => (
        <text x={x(n.lon) + 26 * labelScale} y={y(n.lat) + 9 * labelScale} style={`font-size:${32 * labelScale}px`}>{n.label}</text>
      ))}
    </g>
  </svg>
</div>

<style>
  .wmap svg { width: 100%; height: auto; overflow: visible; }
  .wmap-dots circle { fill: rgba(255, 255, 255, 0.16); }
  .wmap--light .wmap-dots circle { fill: rgba(20, 22, 25, 0.16); }
  .wmap-arc-base { fill: none; stroke: rgba(222, 221, 58, 0.16); stroke-width: 1.5; stroke-dasharray: 4 6; }
  .wmap--light .wmap-arc-base { stroke: rgba(20, 22, 25, 0.08); }
  .wmap-arc {
    fill: none; stroke: var(--lime); stroke-width: 2.4; stroke-linecap: round;
    stroke-dasharray: 0.14 0.86; stroke-dashoffset: 1;
    animation: wm-travel 5.5s linear infinite; animation-delay: calc(var(--i) * -0.9s);
    opacity: 0.9;
  }
  .wmap--light .wmap-arc { stroke: var(--ink); }
  .wmap-arc.is-hub { stroke-width: 3; }
  .wmap-arc.is-route { stroke-width: 3.4; stroke-dasharray: 0.1 0.04 0.06 0.8; animation-duration: 4.2s; animation-delay: 0s; opacity: 1; }
  .wmap-route-mark { fill: none; stroke: var(--lime); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  .wmap--light .wmap-route-mark { stroke: var(--ink); }
  .wmap-route text { font-family: var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; fill: var(--lime); }
  .wmap--light .wmap-route text { fill: var(--ink); }
  @keyframes wm-travel { to { stroke-dashoffset: 0; } }
  .wmap-core { fill: var(--lime); }
  .wmap-ring { fill: none; stroke: var(--lime); stroke-width: 1.5; opacity: 0.6; transform-origin: center; animation: wm-pulse 2.8s var(--ease) infinite; animation-delay: calc(var(--i) * 0.3s); }
  .wmap--light .wmap-core { fill: var(--ink); }
  .wmap--light .wmap-ring { stroke: var(--ink); }
  .is-mfr .wmap-core { fill: #fff; }
  .wmap--light .is-mfr .wmap-core { fill: var(--graphite); }
  .is-mfr .wmap-ring { stroke: #fff; opacity: 0.35; }
  @keyframes wm-pulse { 0% { transform: scale(0.6); opacity: 0.8; } 100% { transform: scale(2.4); opacity: 0; } }
  .wmap-labels text { font-family: var(--font-mono); font-size: 32px; letter-spacing: 0.06em; fill: var(--on-dark); text-transform: uppercase; }
  .wmap--light .wmap-labels text { fill: var(--ink); }
  @media (max-width: 760px) { .wmap-labels, .wmap-route text { display: none; } }
  @media (prefers-reduced-motion: reduce) {
    .wmap-arc { animation: none; stroke-dasharray: none; opacity: 0.5; }
    .wmap-arc.is-route { opacity: 0.95; }
    .wmap-ring { animation: none; }
  }
</style>
