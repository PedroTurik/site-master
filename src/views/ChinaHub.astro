---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import WorldMap from '../components/WorldMap.astro';
import Trace from '../components/Trace.astro';
import Photo from '../components/Photo.astro';
import ContactSection from '../components/ContactSection.astro';
import ConsolidationFlow from '../components/ConsolidationFlow.astro';
import { type Lang, url, routes } from '../i18n/routes';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const other = lang === 'pt' ? 'en' : 'pt';
const hubYears = new Date().getFullYear() - 2001;

const c = {
  pt: {
    metaTitle: 'China HUB · Fábricas e consolidação de cargas na China',
    desc: 'Unidade ISO 9001 da Mastertronics na China, desde 2001: desenvolvimento, auditoria e qualificação de fábricas, consolidação de cargas e compra direto da fábrica com garantia, rastreabilidade e suporte técnico.',
    crumb: 'China HUB',
    h1: 'Fábricas desenvolvidas na China, <em>com logística até você.</em>',
    lead: 'O China HUB desenvolve, audita e qualifica fábricas na China para os clientes da Mastertronics e consolida as cargas dessas fábricas. A Mastertronics é o fornecedor e exporta para você — ou a fábrica exporta direto, na compra direto de fábrica.',
    chips: ['ISO 9001', 'Desde 2001', 'Direto da fábrica', 'Consolidação de cargas'],
    cta: 'Envie sua demanda',
    route: 'Consolidação · Exportação',
    story: {
      label: 'Trajetória',
      title: `${hubYears} anos desenvolvendo fábricas na China.`,
      items: [
        { y: '2001', t: 'Início da operação', p: 'Em 2001, iniciamos o suporte a placas de circuito impresso por meio da operação de um hub na China, dedicado ao desenvolvimento, auditoria e qualificação de fábricas.' },
        { y: '2020', t: 'Ampliação do escopo', p: 'Em 2020, impulsionados pelos desafios da pandemia, ampliamos a atuação desse hub para incluir a prospecção de fábricas de outros insumos, como conectores, cabos customizados, componentes magnéticos (indutores e transformadores), baterias, peças plásticas e metálicas customizadas, componentes passivos, além de semicondutores de baixa complexidade, como diodos, transistores, triacs e outros CIs que não estão disponíveis no portfólio dos fabricantes que representamos. Essa operação segue em constante evolução, atendendo às demandas específicas de cada cliente.' },
        { y: 'Hoje', t: 'Fábricas e logística', p: 'Operamos uma unidade ISO 9001 na China que desenvolve e qualifica fábricas e consolida as cargas dessas fábricas até a exportação, com foco em confiabilidade e redução de custos.' },
      ],
    },
    scope: {
      label: 'Escopo',
      title: 'O que desenvolvemos para você',
      sub: 'Fábricas de insumos além do portfólio dos fabricantes que representamos, desenvolvidas conforme a necessidade de cada cliente.',
      items: [
        { i: 'layers', t: 'Placas de circuito impresso', d: 'O ponto de partida do HUB, em 2001.' },
        { i: 'plug', t: 'Conectores', d: 'Padrão e específicos da aplicação.' },
        { i: 'cable', t: 'Cabos customizados', d: 'Conforme a especificação do cliente.' },
        { i: 'coil', t: 'Componentes magnéticos', d: 'Indutores e transformadores.' },
        { i: 'battery', t: 'Baterias', d: 'Para produtos e sistemas eletrônicos.' },
        { i: 'box', t: 'Peças plásticas e metálicas', d: 'Customizadas conforme projeto.' },
        { i: 'resistor', t: 'Componentes passivos', d: 'Resistores, capacitores e afins.' },
        { i: 'bolt', t: 'Semicondutores discretos', d: 'Diodos, transistores, triacs e outros de baixa complexidade.' },
        { i: 'chip', t: 'CIs além do portfólio', d: 'Circuitos integrados não cobertos pelos nossos fabricantes.' },
      ],
    },
    process: {
      label: 'Como funciona',
      title: 'Da demanda à exportação.',
      steps: [
        { t: 'Demanda', d: 'Partimos da especificação e das necessidades específicas do seu projeto.' },
        { t: 'Desenvolvimento da fábrica', d: 'Prospectamos fábricas aptas a produzir a peça e auditamos cada candidata.' },
        { t: 'Qualificação', d: 'Qualificamos a fábrica com foco em confiabilidade e redução de custos.' },
        { t: 'Produção & consolidação', d: 'As fábricas produzem e o China HUB consolida as cargas na China.' },
        { t: 'Exportação', d: 'A Mastertronics exporta para você — ou a fábrica exporta direto, na compra direto de fábrica.' },
      ],
    },
    why: [
      { v: 'ISO 9001', l: 'Unidade certificada na China.' },
      { v: '2001', l: `${hubYears} anos de experiência no mercado chinês.` },
      { v: 'Sob medida', l: 'Cada desenvolvimento parte da demanda específica do cliente.' },
    ],
    flow: {
      label: 'Logística',
      title: 'Consolidação de cargas na China.',
      p: 'As peças produzidas pelas fábricas que desenvolvemos são reunidas e consolidadas no China HUB antes da exportação. A Mastertronics é o fornecedor e o exportador para o cliente — ou, na compra direto de fábrica, a própria fábrica exporta direto.',
    },
    direct: {
      label: 'Direto da fábrica',
      title: 'Sem distribuidores chineses. Sem brokers.',
      p: 'Compramos direto das fábricas que desenvolvemos. Sem intermediários entre você e a fábrica, a Mastertronics responde pela peça que fornece.',
      cols: ['', 'Distribuidores chineses e brokers', 'Direto da fábrica, com a Mastertronics'],
      rows: [
        { k: 'Origem', a: 'Intermediários entre você e a fábrica', b: 'Fábrica desenvolvida e auditada pelo China HUB' },
        { k: 'Garantia', a: 'Varia conforme cada intermediário', b: 'Garantia das peças, dada pela Mastertronics' },
        { k: 'Rastreabilidade', a: 'Cadeia com elos difíceis de verificar', b: 'Rastreabilidade da fábrica até você' },
        { k: 'Suporte técnico', a: 'Nem sempre disponível', b: 'Suporte técnico das peças, com a nossa equipe' },
      ],
    },
    contactTitle: 'Qual peça ou produto você precisa?',
    contactIntro: 'Envie a especificação ou descreva a sua necessidade. Nossa equipe avalia a demanda e retorna com os próximos passos.',
  },
  en: {
    metaTitle: 'China HUB · Factories and cargo consolidation in China',
    desc: 'Mastertronics’ ISO 9001-certified unit in China, since 2001: factory development, auditing and qualification, cargo consolidation and direct-from-factory supply with warranty, traceability and technical support.',
    crumb: 'China HUB',
    h1: 'Factories developed in China, <em>with logistics all the way to you.</em>',
    lead: 'The China HUB develops, audits and qualifies factories in China for Mastertronics’ customers and consolidates the cargo from those factories. Mastertronics is the supplier and exports to you — or the factory exports directly when you buy direct from the factory.',
    chips: ['ISO 9001', 'Since 2001', 'Direct from the factory', 'Cargo consolidation'],
    cta: 'Send us your request',
    route: 'Consolidation · Export',
    story: {
      label: 'Our story',
      title: `${hubYears} years developing factories in China.`,
      items: [
        { y: '2001', t: 'Operations begin', p: 'In 2001 we opened our hub in China to support printed circuit boards, dedicated to developing, auditing and qualifying factories.' },
        { y: '2020', t: 'Broader scope', p: 'In 2020, driven by the challenges of the pandemic, we expanded the hub’s operations to include sourcing factories for other materials, such as connectors, custom cables, magnetic components (inductors and transformers), batteries, custom plastic and metal parts, passive components, as well as low-complexity semiconductors such as diodes, transistors, triacs and other ICs that are not available in the portfolio of the manufacturers we represent. This operation continues to evolve, responding to the specific demands of each customer.' },
        { y: 'Today', t: 'Factories and logistics', p: 'We operate an ISO 9001-certified unit in China that develops and qualifies factories and consolidates their cargo all the way to export, with a focus on reliability and cost reduction.' },
      ],
    },
    scope: {
      label: 'Scope',
      title: 'What we develop for you',
      sub: 'Factories for materials beyond the portfolio of the manufacturers we represent, developed around each customer’s needs.',
      items: [
        { i: 'layers', t: 'Printed circuit boards', d: 'Where the HUB started, in 2001.' },
        { i: 'plug', t: 'Connectors', d: 'Standard and application-specific.' },
        { i: 'cable', t: 'Custom cables', d: 'Built to the customer’s specification.' },
        { i: 'coil', t: 'Magnetic components', d: 'Inductors and transformers.' },
        { i: 'battery', t: 'Batteries', d: 'For electronic products and systems.' },
        { i: 'box', t: 'Plastic & metal parts', d: 'Customized to your design.' },
        { i: 'resistor', t: 'Passive components', d: 'Resistors, capacitors and more.' },
        { i: 'bolt', t: 'Discrete semiconductors', d: 'Diodes, transistors, triacs and other low-complexity devices.' },
        { i: 'chip', t: 'ICs beyond our portfolio', d: 'Integrated circuits not covered by our manufacturers.' },
      ],
    },
    process: {
      label: 'How it works',
      title: 'From request to export.',
      steps: [
        { t: 'Request', d: 'We start from the specification and the specific needs of your project.' },
        { t: 'Factory development', d: 'We source factories able to make the part and audit each candidate.' },
        { t: 'Qualification', d: 'We qualify the factory with a focus on reliability and cost reduction.' },
        { t: 'Production & consolidation', d: 'The factories produce and the China HUB consolidates the cargo in China.' },
        { t: 'Export', d: 'Mastertronics exports to you — or the factory exports directly when you buy direct from the factory.' },
      ],
    },
    why: [
      { v: 'ISO 9001', l: 'A certified unit in China.' },
      { v: '2001', l: `${hubYears} years of experience in the Chinese market.` },
      { v: 'Tailored', l: 'Every development starts from the customer’s specific need.' },
    ],
    flow: {
      label: 'Logistics',
      title: 'Cargo consolidation in China.',
      p: 'Parts made by the factories we develop are gathered and consolidated at the China HUB before export. Mastertronics is the supplier and the exporter to the customer — or, when you buy direct from the factory, the factory exports directly.',
    },
    direct: {
      label: 'Direct from the factory',
      title: 'No Chinese distributors. No brokers.',
      p: 'We buy direct from the factories we develop. With no middlemen between you and the factory, Mastertronics stands behind the parts it supplies.',
      cols: ['', 'Chinese distributors and brokers', 'Direct from the factory, with Mastertronics'],
      rows: [
        { k: 'Origin', a: 'Middlemen between you and the factory', b: 'A factory developed and audited by the China HUB' },
        { k: 'Warranty', a: 'Varies with each middleman', b: 'A warranty on the parts, given by Mastertronics' },
        { k: 'Traceability', a: 'A chain with links that are hard to verify', b: 'Traceability from the factory to you' },
        { k: 'Technical support', a: 'Not always available', b: 'Technical support on the parts, from our team' },
      ],
    },
    contactTitle: 'Which part or product do you need?',
    contactIntro: 'Send us the specification or describe what you need. Our team will review the request and get back to you with next steps.',
  },
}[lang];

const nodes = [
  { id: 'poa', label: 'Brasil', lon: -51.2, lat: -30.0, kind: 'hq' as const },
  { id: 'hub', label: 'China HUB', lon: 113.9, lat: 22.6, kind: 'hub' as const },
];
if (lang === 'en') nodes[0].label = 'Brazil';
---
<Base lang={lang} title={c.metaTitle} description={c.desc} alt={routes.chinaHub[other]} headerTheme="dark">
  <section class="hhero dark">
    <div class="hhero-grid" aria-hidden="true"></div>
    <div class="container hhero-in">
      <div class="hhero-copy">
        <nav class="crumbs mono reveal" aria-label={lang === 'pt' ? 'Trilha de navegação' : 'Breadcrumb'}>
          <a href={url(lang, 'home')}>Mastertronics</a><span aria-hidden="true">/</span><span aria-current="page">{c.crumb}</span>
        </nav>
        <h1 class="h1 reveal" style="--d:.05s" set:html={c.h1} />
        <p class="lead reveal" style="--d:.1s">{c.lead}</p>
        <ul class="hchips reveal" style="--d:.14s">{c.chips.map((x) => <li>{x}</li>)}</ul>
        <a href="#contato" class="btn btn--lime reveal" style="--d:.18s">{c.cta}<Icon name="arrow" /></a>
      </div>
      <div class="hhero-map reveal" style="--d:.2s"><WorldMap nodes={nodes} labelScale={1.7} route={c.route} /></div>
    </div>
    <Trace />
  </section>

  <section class="section white story">
    <div class="container story-grid">
      <div class="story-head">
        <span class="label reveal">{c.story.label}</span>
        <h2 class="h2 reveal" style="--d:.05s">{c.story.title}</h2>
        <div class="story-fig reveal" style="--d:.1s"><Photo name="inspection" alt="" sizes="(max-width: 900px) 100vw, 40vw" /></div>
      </div>
      <ol class="tl">
        {c.story.items.map((it, i) => (
          <li class="reveal" style={`--d:${i * 0.06}s`}>
            <span class="tl-y">{it.y}</span>
            <div>
              <h3 class="h4">{it.t}</h3>
              <p>{it.p}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section scope">
    <div class="container">
      <div class="scope-head">
        <span class="label reveal">{c.scope.label}</span>
        <h2 class="h2 reveal" style="--d:.05s">{c.scope.title}</h2>
        <p class="lead reveal" style="--d:.1s">{c.scope.sub}</p>
      </div>
      <ul class="sgrid">
        {c.scope.items.map((it, i) => (
          <li class="reveal" style={`--d:${(i % 3) * 0.05}s`}>
            <span class="s-num mono">{String(i + 1).padStart(2, '0')}</span>
            <span class="s-ic"><Icon name={it.i as any} size={22} /></span>
            <h3 class="h4">{it.t}</h3>
            <p>{it.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section dark process">
    <div class="container">
      <div class="scope-head">
        <span class="label reveal">{c.process.label}</span>
        <h2 class="h2 reveal" style="--d:.05s">{c.process.title}</h2>
      </div>
      <ol class="steps">
        {c.process.steps.map((s, i) => (
          <li class="reveal" style={`--d:${i * 0.08}s`}>
            <span class="st-n mono">0{i + 1}</span>
            <span class="st-dot" aria-hidden="true"></span>
            <h3 class="st-t">{s.t}</h3>
            <p>{s.d}</p>
          </li>
        ))}
      </ol>
      <dl class="hwhy">
        {c.why.map((w, i) => <div class="reveal" style={`--d:${i * 0.06}s`}><dt>{w.v}</dt><dd>{w.l}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="section white flow">
    <div class="container">
      <div class="split-head">
        <div>
          <span class="label reveal">{c.flow.label}</span>
          <h2 class="h2 reveal" style="--d:.05s">{c.flow.title}</h2>
        </div>
        <p class="lead reveal" style="--d:.1s">{c.flow.p}</p>
      </div>
      <div class="reveal" style="--d:.1s"><ConsolidationFlow lang={lang} /></div>
    </div>
  </section>

  <section class="section direct">
    <div class="container direct-grid">
      <div class="direct-head">
        <span class="label reveal">{c.direct.label}</span>
        <h2 class="h2 reveal" style="--d:.05s">{c.direct.title}</h2>
        <p class="lead reveal" style="--d:.1s">{c.direct.p}</p>
      </div>
      <div class="cmp-wrap reveal" style="--d:.1s">
        <table class="cmp">
          <thead>
            <tr>
              <td></td>
              <th scope="col" class="cmp-a">{c.direct.cols[1]}</th>
              <th scope="col" class="cmp-b">{c.direct.cols[2]}</th>
            </tr>
          </thead>
          <tbody>
            {c.direct.rows.map((r) => (
              <tr>
                <th scope="row" class="mono">{r.k}</th>
                <td class="cmp-a" data-col={c.direct.cols[1]}><Icon name="minus" size={16} /><span>{r.a}</span></td>
                <td class="cmp-b" data-col={c.direct.cols[2]}><Icon name="check" size={16} /><span>{r.b}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <ContactSection lang={lang} topic="hub" title={c.contactTitle} intro={c.contactIntro} />
</Base>

<style>
  .hhero { position: relative; overflow: hidden; padding-top: clamp(130px, 14vw, 180px); isolation: isolate; }
  .hhero::before { content: ''; position: absolute; inset: 0; z-index: -1; background: radial-gradient(50% 60% at 85% 45%, rgba(222,221,58,.08), transparent 70%); }
  .hhero-grid { position: absolute; inset: 0; z-index: -1; background-image: linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px); background-size: 72px 72px; mask-image: radial-gradient(80% 70% at 50% 30%, #000 30%, transparent 100%); }
  .hhero-in { display: grid; grid-template-columns: 1.15fr 1fr; gap: 40px; align-items: center; }
  .hhero h1 { font-size: clamp(2.5rem, 5vw, 4.4rem); max-width: 14ch; }
  .hhero-copy { display: grid; gap: 24px; justify-items: start; }
  .hhero h1 { color: #fff; }
  .hhero h1 :global(em) { font-style: normal; color: #8f949b; }
  .crumbs { display: flex; gap: 10px; font-size: .75rem; text-transform: uppercase; letter-spacing: .06em; color: var(--on-dark-muted); }
  .crumbs a:hover { color: #fff; }
  .crumbs [aria-current] { color: var(--lime); }
  .hchips { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .hchips li { font-family: var(--font-mono); font-size: .75rem; text-transform: uppercase; letter-spacing: .05em; padding: 7px 12px 6px; border-radius: 999px; border: 1px solid var(--line-dark); color: var(--on-dark); }
  .hchips li:first-child { border-color: rgba(222,221,58,.4); color: var(--lime); }
  .hhero-map { margin-right: -12%; }
  @media (max-width: 960px) { .hhero-in { grid-template-columns: 1fr; } .hhero-map { display: none; } .hhero { padding-bottom: 24px; } }

  .story-grid { display: grid; grid-template-columns: 1fr 1.3fr; gap: clamp(40px, 7vw, 110px); align-items: start; }
  .story-head { display: grid; gap: 18px; position: sticky; top: 110px; }
  .story-fig { margin-top: 18px; border-radius: 18px; overflow: hidden; aspect-ratio: 4 / 3; background: var(--ink); }
  .story-fig :global(img), .story-fig :global(.photo-missing) { width: 100%; height: 100%; object-fit: cover; }
  .tl { list-style: none; padding: 0; border-left: 1px solid var(--line-strong); }
  .tl li { position: relative; display: grid; grid-template-columns: 100px 1fr; gap: 20px; padding: 0 0 44px 32px; }
  .tl li::before { content: ''; position: absolute; left: -5px; top: 10px; width: 9px; height: 9px; border-radius: 2px; background: var(--white); border: 1.5px solid var(--ink); }
  .tl li:last-child::before { background: var(--lime); border-color: var(--ink); }
  .tl-y { font-family: var(--font-display); font-size: 1.75rem; font-weight: 600; letter-spacing: -.04em; line-height: 1.1; }
  .tl h3 { margin-bottom: 8px; }
  .tl p { color: var(--slate); line-height: 1.7; }
  @media (max-width: 900px) { .story-grid { grid-template-columns: 1fr; } .story-head { position: static; } }
  @media (max-width: 560px) { .tl li { grid-template-columns: 1fr; gap: 6px; padding-left: 24px; } }

  .scope-head { display: grid; gap: 18px; max-width: 720px; margin-bottom: 52px; }
  .process h2 { color: #fff; }
  .sgrid { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .sgrid li { position: relative; display: grid; gap: 8px; align-content: start; padding: 26px; border-radius: 16px; background: var(--white); border: 1px solid var(--line); transition: border-color .3s, box-shadow .3s; }
  .sgrid li:hover { border-color: var(--line-strong); box-shadow: var(--shadow-1); }
  .s-num { position: absolute; top: 24px; right: 24px; font-size: .6875rem; color: var(--muted); }
  .s-ic { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 10px; background: var(--paper); border: 1px solid var(--line); margin-bottom: 10px; }
  .sgrid li:hover .s-ic { background: var(--lime); border-color: var(--lime); }
  .sgrid p { color: var(--slate); font-size: .9375rem; }
  @media (max-width: 900px) { .sgrid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .sgrid { grid-template-columns: 1fr; } }

  .steps { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); position: relative; }
  .steps::before { content: ''; position: absolute; left: 0; right: 0; top: 43px; height: 1px; background: var(--line-dark); }
  .steps li { position: relative; display: grid; gap: 12px; padding-right: 24px; align-content: start; }
  .st-n { color: var(--lime); font-size: .75rem; }
  .st-dot { width: 13px; height: 13px; border-radius: 3px; background: var(--ink); border: 1.5px solid var(--lime); margin: 4px 0 14px; position: relative; z-index: 1; }
  .steps li:last-child .st-dot { background: var(--lime); }
  .st-t { color: #fff; font-size: clamp(1.15rem, 1.5vw, 1.375rem); letter-spacing: -.025em; line-height: 1.15; }
  .steps p { font-size: .9375rem; }
  @media (max-width: 1060px) and (min-width: 861px) { .steps { grid-template-columns: repeat(3, 1fr); row-gap: 44px; } .steps::before { display: none; } }
  @media (max-width: 860px) {
    .steps { grid-template-columns: 1fr; gap: 28px; padding-left: 28px; }
    .steps::before { left: 6px; right: auto; top: 0; bottom: 0; width: 1px; height: auto; }
    .st-dot { position: absolute; left: -28px; top: 22px; margin: 0; }
  }
  .hwhy { display: grid; grid-template-columns: repeat(3, 1fr); margin-top: 80px; border-top: 1px solid var(--line-dark); }
  .hwhy div { padding: 28px 24px 0 0; display: grid; gap: 8px; align-content: start; }
  .hwhy div + div { padding-left: 24px; border-left: 1px solid var(--line-dark); }
  .hwhy dt { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.75rem, 3vw, 2.5rem); letter-spacing: -.04em; color: #fff; line-height: 1; }
  .hwhy dd { color: var(--on-dark-muted); font-size: .9375rem; max-width: 30ch; }
  @media (max-width: 760px) { .hwhy { grid-template-columns: 1fr; } .hwhy div + div { padding-left: 0; border-left: 0; } .hwhy div { padding-bottom: 20px; border-bottom: 1px solid var(--line-dark); } }

  .split-head { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 6vw, 96px); align-items: end; margin-bottom: clamp(36px, 5vw, 56px); }
  .split-head > div { display: grid; gap: 18px; }
  .split-head .lead { font-size: 1.0625rem; }
  @media (max-width: 900px) { .split-head { grid-template-columns: 1fr; } }

  .direct { background: var(--paper); }
  .direct-grid { display: grid; grid-template-columns: 1fr 1.45fr; gap: clamp(40px, 6vw, 96px); align-items: center; }
  .direct-head { display: grid; gap: 20px; }
