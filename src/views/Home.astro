---
import Base from '../layouts/Base.astro';
import homeContent from '../content/home.json';
import { fill } from '../lib/content';
import WorldMap from '../components/WorldMap.astro';
import MfrTile from '../components/MfrTile.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import ContactSection from '../components/ContactSection.astro';
import Trace from '../components/Trace.astro';
import { manufacturers } from '../data/manufacturers';
import { company } from '../data/company';
import { type Lang, type RouteKey, url } from '../i18n/routes';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const n = manufacturers.length;
const years = new Date().getFullYear() - company.founded;
const hubYears = new Date().getFullYear() - 2001;

const c = fill(homeContent, { years, n, hubYears })[lang];

const mapNodes = [
  { id: 'poa', label: 'Porto Alegre', lon: -51.2, lat: -30.0, kind: 'hq' as const },
  { id: 'uk', label: 'UK', lon: -0.5, lat: 53.2, kind: 'mfr' as const },
  { id: 'tj', label: 'Tianjin', lon: 117.2, lat: 39.1, kind: 'mfr' as const },
  { id: 'nb', label: 'Ningbo', lon: 121.5, lat: 29.9, kind: 'mfr' as const },
  { id: 'tw', label: 'Taiwan', lon: 121.0, lat: 24.2, kind: 'mfr' as const },
  { id: 'zz', label: 'Zhuzhou', lon: 113.1, lat: 27.8, kind: 'mfr' as const },
  { id: 'hub', label: 'China HUB', lon: 113.9, lat: 22.6, kind: 'hub' as const },
];
const marquee = [...manufacturers, ...manufacturers];
---
<Base lang={lang} title={c.meta.title} description={c.meta.desc} alt={lang === 'pt' ? '/en/' : '/'} headerTheme="dark">
  <!-- HERO -->
  <section class="hero dark">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="container hero-in">
      <div class="hero-copy">
        <span class="label reveal">{c.hero.label}</span>
        <h1 class="display reveal" style="--d:.06s">{c.hero.title[0]}<br /><span class="hero-soft">{c.hero.title[1]}</span></h1>
        <p class="lead reveal" style="--d:.14s">{c.hero.sub}</p>
        <div class="hero-ctas reveal" style="--d:.2s">
          <a href={url(lang, 'contact')} class="btn btn--lime">{c.hero.cta1}<Icon name="arrow" /></a>
          <a href="#frentes" class="btn btn--ghost">{c.hero.cta2}</a>
        </div>
      </div>
      <div class="hero-map reveal" style="--d:.25s"><WorldMap nodes={mapNodes} route={c.route} /></div>
    </div>
    <div class="container">
      <dl class="stats">
        {c.stats.map((s, i) => (
          <div class="stat reveal" style={`--d:${0.3 + i * 0.06}s`}>
            <dt class="stat-v">{s.v}</dt>
            <dd class="stat-l">{s.l}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- LOGO MARQUEE -->
  <section class="mq" aria-label={c.marquee}>
    <p class="mq-h mono">{c.marquee}</p>
    <div class="mq-track-wrap">
      <ul class="mq-track">
        {marquee.map((m, i) => (
          <li aria-hidden={i >= manufacturers.length ? 'true' : undefined}>
            <a href={`${url(lang, 'manufacturers')}${m.slug}/`} tabindex={i >= manufacturers.length ? -1 : undefined}>
              <img src={m.logo} alt={i >= manufacturers.length ? '' : m.name} loading="lazy" style={`--s:${m.logoScale ?? 1}`} />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FRONTS -->
  <section class="section fronts" id="frentes">
    <div class="container">
      <div class="shead shead--split">
        <div>
          <span class="label reveal">{c.fronts.label}</span>
          <h2 class="h2 reveal" style="--d:.05s">{c.fronts.title}</h2>
        </div>
        <p class="lead reveal" style="--d:.1s">{c.fronts.sub}</p>
      </div>
      <div class="fgrid">
        {c.fronts.items.map((f, i) => (
          <article class="front reveal" style={`--d:${i * 0.08}s`}>
            <div class="front-img">
              <Photo name={f.photo} alt="" sizes="(max-width: 900px) 100vw, 50vw" />
              <span class="front-n mono">{f.n}</span>
            </div>
            <div class="front-body">
              <span class="front-tag mono">{f.tag}</span>
              <h3 class="front-title">{f.title}</h3>
              <p class="front-text">{f.text}</p>
              <dl class="front-spec">
                {f.spec.map((r) => <div><dt class="mono">{r.k}</dt><dd>{r.v}</dd></div>)}
              </dl>
              <a href={url(lang, f.key as RouteKey)} class="link-arrow front-cta"><span>{f.cta}</span><Icon name="arrow" /></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- DIRECT FROM THE FACTORY -->
  <section class="section dark direct">
    <div class="container">
      <div class="shead shead--split direct-head">
        <div>
          <span class="label reveal">{c.direct.label}</span>
          <h2 class="h2 reveal" style="--d:.05s">{c.direct.title}</h2>
        </div>
        <p class="lead reveal" style="--d:.1s">{c.direct.p}</p>
      </div>
    </div>
    <Trace class="direct-trace" />
    <div class="container">
      <ol class="direct-list">
        {c.direct.items.map((g, i) => (
          <li class="reveal" style={`--d:${i * 0.08}s`}>
            <span class="direct-ic"><Icon name={g.i as any} size={22} /></span>
            <span class="direct-n mono">0{i + 1}</span>
            <h3 class="h3">{g.t}</h3>
            <p>{g.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="section white about">
    <div class="container about-grid">
      <div class="about-fig reveal">
        <Photo name="cleanroom" alt="" sizes="(max-width: 900px) 100vw, 50vw" position="35% 50%" />
        <div class="about-badge">
          <strong>{c.about.badge}</strong>
          <span>{c.about.badgeL}</span>
        </div>
      </div>
      <div class="about-copy">
        <span class="label reveal">{c.about.label}</span>
        <h2 class="h2 reveal" style="--d:.05s">{c.about.title}</h2>
        <div class="prose reveal" style="--d:.1s">
          <p class="about-lead">{c.about.p1}</p>
          <p>{c.about.p2}</p>
        </div>
        <a href={url(lang, 'about')} class="btn btn--primary reveal" style="--d:.15s">{c.about.more}<Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- MANUFACTURERS -->
  <section class="section mfr">
    <div class="container">
      <div class="shead shead--row">
        <div>
          <span class="label reveal">{c.mfr.label}</span>
          <h2 class="h2 reveal" style="--d:.05s">{c.mfr.title}</h2>
          <p class="lead reveal" style="--d:.1s">{c.mfr.sub}</p>
        </div>
        <a href={url(lang, 'manufacturers')} class="btn btn--ghost reveal">{c.mfr.all}<Icon name="arrow" /></a>
      </div>
      <div class="lgrid">
        {manufacturers.map((m, i) => <div class="reveal" style={`--d:${(i % 4) * 0.05}s`}><MfrTile m={m} lang={lang} /></div>)}
      </div>
    </div>
  </section>


  <!-- CHINA HUB -->
  <section class="section dark hub">
    <div class="container hub-grid">
      <div class="hub-fig reveal">
        <Photo name="factory" alt="" sizes="(max-width: 900px) 100vw, 45vw" />
        <div class="hub-badge">
          <Icon name="shield" size={26} />
          <div><strong>ISO 9001</strong><span>{c.hub.badge}</span></div>
          <div class="hub-since"><span>{c.hub.since}</span><strong>2001</strong></div>
        </div>
      </div>
      <div class="hub-copy">
        <span class="label reveal">{c.hub.label}</span>
        <h2 class="h2 reveal" style="--d:.05s">{c.hub.title}</h2>
        <div class="hub-p reveal" style="--d:.1s"><p>{c.hub.p0}</p><p>{c.hub.p}</p></div>
        <ol class="hub-steps reveal" style="--d:.14s">
          {c.hub.steps.map((s, i) => <li><span class="mono">0{i + 1}</span>{s}</li>)}
        </ol>
        <a href={url(lang, 'chinaHub')} class="btn btn--lime reveal" style="--d:.18s">{c.hub.cta}<Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- ENERGY -->
  <section class="energy dark">
    <div class="energy-bg" aria-hidden="true"><Photo name="wind" alt="" sizes="100vw" /></div>
    <div class="container energy-in">
      <div class="energy-copy">
        <span class="label reveal">{c.energy.label}</span>
        <h2 class="h2 reveal" style="--d:.05s">{c.energy.title}</h2>
        <p class="lead reveal" style="--d:.1s">{c.energy.p}</p>
        <a href={url(lang, 'renewables')} class="btn btn--lime reveal" style="--d:.15s">{c.energy.cta}<Icon name="arrow" /></a>
      </div>
      <dl class="energy-stats">
        {c.energy.stats.map((s, i) => <div class="reveal" style={`--d:${i * 0.06}s`}><dt>{s.v}</dt><dd>{s.l}</dd></div>)}
      </dl>
    </div>
  </section>

  <ContactSection lang={lang} />
</Base>

<style>
  /* HERO */
  .hero { position: relative; overflow: hidden; padding-top: clamp(130px, 16vw, 180px); padding-bottom: 48px; isolation: isolate; }
  .hero::before { content: ''; position: absolute; inset: 0; z-index: -1; background: radial-gradient(60% 50% at 78% 55%, rgba(222,221,58,.07), transparent 70%), radial-gradient(50% 60% at 10% 0%, rgba(255,255,255,.05), transparent 70%); }
  .hero-grid { position: absolute; inset: 0; z-index: -1; opacity: .5; background-image: linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px); background-size: 72px 72px; mask-image: radial-gradient(80% 70% at 50% 40%, #000 30%, transparent 100%); }
  .hero-in { position: relative; min-height: 560px; }
  .hero-copy { position: relative; z-index: 2; display: grid; gap: 26px; max-width: 880px; }
  .hero-copy .display { font-size: clamp(2.4rem, 4.8vw, 4.2rem); }
  .hero h1 { color: #fff; }
  .hero-soft { color: #8f949b; }
  .hero .lead { max-width: 590px; }
  .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 6px; }
  .hero-map { position: absolute; z-index: 1; pointer-events: none; width: min(1180px, 88vw); right: calc(var(--gutter) * -1 - 4vw); top: -10px; -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 34%); mask-image: linear-gradient(90deg, transparent 0%, #000 34%); }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line-dark); margin-top: 24px; }
  .stat { padding: 28px 24px 8px 0; display: grid; gap: 6px; align-content: start; }
  .stat + .stat { padding-left: 24px; border-left: 1px solid var(--line-dark); }
  .stat-v { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.75rem, 3vw, 2.5rem); letter-spacing: -0.04em; color: #fff; line-height: 1; }
  .stat-l { font-size: 0.875rem; color: var(--on-dark-muted); }
  @media (max-width: 1100px) { .hero-in { min-height: 0; } .hero-map { position: relative; right: auto; top: auto; width: auto; margin: -40px -8% 0 10%; } }
  @media (max-width: 760px) {
    .hero-map { margin: 28px -18% 0 -6%; -webkit-mask-image: none; mask-image: none; }
    .stats { grid-template-columns: 1fr 1fr; }
    .stat + .stat:nth-child(3) { padding-left: 0; border-left: 0; }
    .stat:nth-child(n+3) { border-top: 1px solid var(--line-dark); }
  }

  /* MARQUEE */
  .mq { background: var(--white); border-bottom: 1px solid var(--line); padding: 34px 0 32px; overflow: hidden; }
  .mq-h { text-align: center; font-size: .6875rem; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); margin-bottom: 22px; padding-inline: var(--gutter); }
  .mq-track-wrap { mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
  .mq-track { list-style: none; padding: 0; display: flex; width: max-content; animation: mq 60s linear infinite; }
  .mq-track-wrap:hover .mq-track { animation-play-state: paused; }
  .mq-track li { flex: none; }
  .mq-track a { display: grid; place-items: center; width: 210px; height: 64px; padding: 0 28px; }
  .mq-track img { max-height: calc(38px * var(--s)); max-width: 100%; object-fit: contain; }
  @keyframes mq { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .mq-track { animation: none; flex-wrap: wrap; width: auto; justify-content: center; } .mq-track li[aria-hidden] { display: none; } }

  /* SECTION HEAD */
  .shead { display: grid; gap: 18px; max-width: 800px; margin-bottom: clamp(40px, 5vw, 60px); }
  .shead--row { max-width: none; display: flex; justify-content: space-between; align-items: flex-end; gap: 32px; flex-wrap: wrap; }
  .shead--row > div { display: grid; gap: 18px; max-width: 680px; }

  .shead--split { max-width: none; grid-template-columns: 1.15fr 1fr; gap: clamp(24px, 6vw, 96px); align-items: end; }
  .shead--split > div { display: grid; gap: 18px; }
  .shead--split .lead { font-size: 1.0625rem; }
  @media (max-width: 900px) { .shead--split { grid-template-columns: 1fr; } }

  /* FRONTS */
  .fgrid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .front { position: relative; display: grid; grid-template-rows: auto 1fr; border-radius: 22px; overflow: hidden; background: var(--white); border: 1px solid var(--line); transition: box-shadow .4s var(--ease), transform .4s var(--ease), border-color .4s; }
  .front:hover { box-shadow: var(--shadow-2); transform: translateY(-3px); border-color: var(--line-strong); }
  .front-img { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; background: var(--ink); }
  .front-img :global(img), .front-img :global(.photo-missing) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease); }
  .front:hover .front-img :global(img) { transform: scale(1.04); }
  .front-img::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(20,22,25,.45), transparent 40%); }
  .front-n { position: absolute; z-index: 1; top: 18px; left: 20px; display: inline-grid; place-items: center; min-width: 38px; height: 26px; padding: 0 9px; border-radius: 6px; font-size: .75rem; background: var(--lime); color: var(--ink); font-weight: 600; }
  .front-body { display: flex; flex-direction: column; gap: 14px; padding: clamp(24px, 3vw, 36px); }
  .front-tag { font-size: .6875rem; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); }
  .front-title { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.5rem, 2.2vw, 1.875rem); letter-spacing: -.03em; line-height: 1.12; }
  .front-text { color: var(--slate); font-size: 1rem; line-height: 1.65; }
  .front-spec { display: grid; margin-top: 6px; border-top: 1px solid var(--ink); }
  .front-spec div { display: grid; grid-template-columns: 128px 1fr; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .front-spec dt { font-size: .6875rem; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); padding-top: 3px; }
  .front-spec dd { font-size: .9375rem; font-weight: 550; line-height: 1.45; }
  .front-cta { margin-top: auto; padding-top: 10px; align-self: flex-start; }
  /* whole card is clickable through the CTA */
  .front-cta::after { content: ''; position: absolute; inset: 0; z-index: 2; border-radius: inherit; }
  .front-cta:focus-visible { outline: none; }
  .front:has(.front-cta:focus-visible) { outline: 2px solid var(--lime); outline-offset: 3px; }
  .front:hover .front-cta span { background-size: 100% 1px; }
  .front:hover .front-cta :global(svg) { transform: translateX(4px); }
  @media (max-width: 900px) { .fgrid { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .front-spec div { grid-template-columns: 1fr; gap: 4px; } }

  /* DIRECT FROM THE FACTORY */
  .direct { position: relative; overflow: hidden; isolation: isolate; }
  .direct::before { content: ''; position: absolute; inset: 0; z-index: -1; background: radial-gradient(45% 60% at 0% 100%, rgba(222,221,58,.07), transparent 70%); }
  .direct h2 { color: #fff; max-width: 15ch; }
  .direct-head { margin-bottom: clamp(24px, 3vw, 40px); }
  .direct-trace { margin-bottom: clamp(36px, 4.5vw, 64px); }
  .direct-list { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); }
  .direct-list li { position: relative; display: grid; grid-template-columns: auto 1fr; column-gap: 16px; row-gap: 12px; align-content: start; padding: 4px 32px 4px 0; }
  .direct-list li + li { padding-left: 32px; border-left: 1px solid var(--line-dark); }
  .direct-ic { width: 46px; height: 46px; display: grid; place-items: center; border-radius: 12px; background: var(--lime); color: var(--ink); }
  .direct-n { align-self: center; justify-self: end; color: var(--on-dark-muted); font-size: .75rem; }
  .direct-list h3 { grid-column: 1 / -1; color: #fff; margin-top: 10px; }
  .direct-list p { grid-column: 1 / -1; font-size: .9375rem; line-height: 1.6; max-width: 34ch; }
  @media (max-width: 860px) {
    .direct-list { grid-template-columns: 1fr; }
    .direct-list li, .direct-list li + li { padding: 26px 0; border-left: 0; border-top: 1px solid var(--line-dark); }
    .direct-list li:first-child { border-top: 0; padding-top: 0; }
  }

  /* ABOUT */
  .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 7vw, 110px); align-items: center; }
  .about-fig { position: relative; border-radius: 22px; overflow: hidden; aspect-ratio: 4 / 5; background: var(--ink); }
  .about-fig :global(img), .about-fig :global(.photo-missing) { width: 100%; height: 100%; object-fit: cover; }
  .about-badge { position: absolute; left: 20px; bottom: 20px; right: 20px; display: flex; align-items: baseline; gap: 14px; padding: 18px 22px; border-radius: 14px; background: rgba(20,22,25,.72); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); color: #fff; border: 1px solid rgba(255,255,255,.1); }
  .about-badge strong { font-family: var(--font-display); font-size: 2rem; letter-spacing: -.04em; line-height: 1; color: var(--lime); white-space: nowrap; }
  .about-badge span { font-size: .875rem; color: #c9ccd0; }
  .about-copy { display: grid; gap: 24px; justify-items: start; }
  .about-lead { font-size: 1.1875rem !important; color: var(--ink) !important; line-height: 1.6 !important; }
  @media (max-width: 900px) { .about-grid { grid-template-columns: 1fr; } .about-fig { aspect-ratio: 16 / 11; } }

  /* MANUFACTURERS */
  .lgrid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .lgrid > div { height: 100%; min-width: 0; }
  @media (max-width: 1000px) { .lgrid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 720px) { .lgrid { grid-template-columns: repeat(2, 1fr); gap: 10px; } }

  /* HUB */
  .hub-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 7vw, 110px); align-items: center; }
  .hub-fig { position: relative; border-radius: 22px; overflow: hidden; aspect-ratio: 1; background: #22252a; }
  .hub-fig :global(img), .hub-fig :global(.photo-missing) { width: 100%; height: 100%; object-fit: cover; }
  .hub-badge { position: absolute; left: 20px; right: 20px; bottom: 20px; display: grid; grid-template-columns: auto 1fr auto; gap: 16px; align-items: center; padding: 16px 20px; border-radius: 14px; background: rgba(20,22,25,.78); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid rgba(222,221,58,.25); color: var(--lime); }
  .hub-badge div { display: grid; }
  .hub-badge strong { font-family: var(--font-display); font-size: 1.25rem; letter-spacing: -.02em; color: #fff; }
  .hub-badge span { font-size: .8125rem; color: var(--on-dark-muted); }
  .hub-since { text-align: right; padding-left: 16px; border-left: 1px solid rgba(222,221,58,.25); }
  .hub-copy { display: grid; gap: 24px; justify-items: start; }
  .hub h2 { color: #fff; }
  .hub-p { display: grid; gap: 1em; font-size: 1.0625rem; line-height: 1.7; }
  .hub-p p:first-child { color: var(--on-dark); }
  .hub-steps { list-style: none; padding: 0; display: flex; flex-wrap: wrap; align-items: center; gap: 8px 6px; }
  .hub-steps li { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px 8px 12px; border-radius: 999px; border: 1px solid var(--line-dark); font-weight: 550; color: #fff; font-size: .875rem; }
  .hub-steps li:last-child { border-color: rgba(222,221,58,.45); }
  .hub-steps .mono { color: var(--lime); font-size: .6875rem; }
  @media (max-width: 900px) { .hub-grid { grid-template-columns: 1fr; } .hub-fig { aspect-ratio: 16 / 11; } }

  /* ENERGY */
  .energy { position: relative; overflow: hidden; isolation: isolate; padding-block: clamp(110px, 13vw, 180px) clamp(56px, 6vw, 80px); }
  .energy-bg { position: absolute; inset: 0; z-index: -1; }
  .energy-bg :global(img), .energy-bg :global(.photo-missing) { width: 100%; height: 100%; object-fit: cover; }
  .energy-bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(20,22,25,.94) 0%, rgba(20,22,25,.78) 45%, rgba(20,22,25,.35) 100%), linear-gradient(0deg, rgba(20,22,25,.95) 0%, transparent 45%); }
  .energy-in { display: grid; gap: clamp(56px, 8vw, 110px); }
  .energy-copy { display: grid; gap: 22px; justify-items: start; max-width: 680px; }
  .energy h2 { color: #fff; }
  .energy .lead { color: #c3c6cb; }
  .energy-stats { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid rgba(255,255,255,.16); }
  .energy-stats div { padding: 24px 20px 0 0; display: grid; gap: 6px; align-content: start; }
  .energy-stats div + div { padding-left: 20px; border-left: 1px solid rgba(255,255,255,.16); }
