---
import Base from '../layouts/Base.astro';
import WorldMap from '../components/WorldMap.astro';
import MfrTile from '../components/MfrTile.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import ContactSection from '../components/ContactSection.astro';
import Trace from '../components/Trace.astro';
import { manufacturers } from '../data/manufacturers';
import { company } from '../data/company';
import { type Lang, url } from '../i18n/routes';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const n = manufacturers.length;
const years = new Date().getFullYear() - company.founded;
const hubYears = new Date().getFullYear() - 2001;

const c = {
  pt: {
    meta: {
      title: 'Mastertronics · Solução técnica e logística em componentes eletrônicos',
      desc: 'Solução técnica e logística para a indústria eletrônica desde 1991: representação de fabricantes globais de semicondutores e componentes e China HUB ISO 9001, que desenvolve fábricas e consolida cargas na China.',
    },
    hero: {
      label: `Desde 1991 · ${years} anos de mercado`,
      title: ['Solução técnica e logística', 'para a indústria eletrônica.'],
      sub: 'Somos o fornecedor técnico e logístico da sua engenharia e do seu suprimento: representamos fabricantes globais de semicondutores e componentes e, pelo China HUB, desenvolvemos fábricas e consolidamos cargas na China.',
      cta1: 'Fale com um especialista',
      cta2: 'Como atuamos',
    },
    stats: [
      { v: '1991', l: 'No mercado desde a fundação, em Porto Alegre' },
      { v: String(n), l: 'Fabricantes globais representados' },
      { v: `${hubYears} anos`, l: 'Desenvolvendo fábricas e consolidando cargas na China' },
      { v: 'ISO 9001', l: 'China HUB, unidade certificada desde 2001' },
    ],
    route: 'Consolidação · Exportação',
    marquee: 'Fabricantes que representamos no Brasil e na América Latina',
    fronts: {
      label: 'Como atuamos',
      title: 'Uma solução técnica e logística, em duas frentes.',
      sub: 'Do semicondutor de potência à peça customizada, a Mastertronics fornece com suporte técnico local, pelos fabricantes que representamos ou pelas fábricas que desenvolvemos na China.',
      items: [
        {
          photo: 'pcb', n: '01', tag: 'Representação de fabricantes',
          title: 'Fabricantes globais, com suporte técnico local.',
          text: 'Representamos fabricantes internacionais de semicondutores e componentes eletrônicos. Você compra pelo canal de distribuição ou direto da fábrica, sempre com o nosso suporte técnico e comercial.',
          spec: [
            { k: 'Portfólio', v: `Semicondutores e componentes de ${n} fabricantes globais` },
            { k: 'Compra', v: 'Canal de distribuição ou direto da fábrica' },
            { k: 'Mastertronics', v: 'Suporte técnico e comercial, próximo do seu projeto' },
          ],
          cta: 'Ver fabricantes', key: 'manufacturers' as const,
        },
        {
          photo: 'port', n: '02', tag: 'China HUB',
          title: 'Fábricas desenvolvidas e cargas consolidadas na China.',
          text: 'Desenvolvemos fábricas na China para os insumos que o seu projeto precisa e consolidamos as cargas dessas fábricas. O fornecedor é a Mastertronics, que exporta para você — ou a fábrica exporta direto, na compra direto de fábrica.',
          spec: [
            { k: 'Fábricas', v: 'Prospectadas, auditadas e qualificadas pelo HUB' },
            { k: 'Logística', v: 'Consolidação das cargas na China' },
            { k: 'Exportação', v: 'Pela Mastertronics ou direto da fábrica' },
          ],
          cta: 'Conhecer o China HUB', key: 'chinaHub' as const,
        },
      ],
    },
    direct: {
      label: 'Direto da fábrica',
      title: 'Fornecedor somos nós. E respondemos pela peça.',
      p: 'Compramos direto da fábrica, sem intermediários nem brokers. Por isso a Mastertronics responde por cada peça que fornece, com três garantias:',
      items: [
        { i: 'shield', t: 'Garantia', d: 'Garantia das peças fornecidas, dada pela própria Mastertronics.' },
        { i: 'route', t: 'Rastreabilidade', d: 'Origem conhecida: cada peça vem de uma fábrica que desenvolvemos e auditamos.' },
        { i: 'chip', t: 'Suporte técnico', d: 'Apoio técnico na especificação e na aplicação das peças, com agilidade e proximidade.' },
      ],
    },
    about: {
      label: 'A Mastertronics',
      title: 'Cada vez mais próximos de cada cliente.',
      p1: 'Desde 1991, conectamos a indústria eletroeletrônica da América Latina às principais soluções globais em semicondutores e componentes eletrônicos. Hoje, somos uma solução técnica e logística em várias frentes, com atendimento ágil e próximo, antecipando tendências e viabilizando acesso a tecnologias emergentes.',
      p2: 'Nosso portfólio inclui semicondutores de potência, memórias, displays customizados, sensores MEMS, optoacopladores e sensores de corrente e tensão para aplicações industriais e de energia.',
      more: 'Conheça a empresa',
      badge: `${years} anos`,
      badgeL: 'conectando a indústria à tecnologia global',
    },
    mfr: {
      label: 'Portfólio',
      title: 'Nossos fabricantes',
      sub: 'Líderes globais em semicondutores de potência, memórias, sensores, optoeletrônica, displays, cristais e magnéticos.',
      all: 'Ver todos os fabricantes',
    },
    hub: {
      label: 'China HUB',
      title: 'Nosso braço na China: fábricas desenvolvidas, cargas consolidadas.',
      p0: 'Em 2001, iniciamos o suporte a placas de circuito impresso por meio da operação de um hub na China, dedicado ao desenvolvimento, auditoria e qualificação de fábricas.',
      p: 'Hoje, desenvolvemos fábricas de conectores, cabos customizados, componentes magnéticos, baterias, peças plásticas e metálicas customizadas, componentes passivos e semicondutores de baixa complexidade — e consolidamos na China as cargas dessas fábricas até a exportação.',
      steps: ['Demanda', 'Fábrica', 'Qualificação', 'Consolidação', 'Exportação'],
      cta: 'Como funciona o China HUB',
      badge: 'Unidade certificada na China',
      since: 'Desde',
    },
    energy: {
      label: 'Energia renovável · Mastertronics & CRRC',
      title: 'A escala da CRRC para a infraestrutura de energia do Brasil.',
      p: 'Parceria estratégica com as divisões Times Electric e ZhuZhou Institute Comprehensive Energy da CRRC: consultoria, suporte técnico e soluções completas em geração, armazenamento e hidrogênio verde.',
      stats: [
        { v: 'Fortune 500', l: 'Líder global' },
        { v: '+48 GWh', l: 'Em BESS implantados · Top 3 global' },
        { v: '+70 GW', l: 'Top 3 em inversores solares na China' },
        { v: 'Top 1', l: 'Mercado eólico na China' },
      ],
      cta: 'Soluções em energia',
    },
  },
  en: {
    meta: {
      title: 'Mastertronics · Technical and logistics solutions in electronic components',
      desc: 'A technical and logistics solution for the electronics industry since 1991: representation of global semiconductor and component manufacturers and an ISO 9001 China HUB that develops factories and consolidates cargo in China.',
    },
    hero: {
      label: `Since 1991 · ${years} years in the market`,
      title: ['Technical and logistics solutions', 'for the electronics industry.'],
      sub: 'We are the technical and logistics supplier behind your engineering and sourcing: we represent global semiconductor and component manufacturers and, through our China HUB, develop factories and consolidate cargo in China.',
      cta1: 'Talk to a specialist',
      cta2: 'How we work',
    },
    stats: [
      { v: '1991', l: 'In the market since our founding in Porto Alegre' },
      { v: String(n), l: 'Global manufacturers represented' },
      { v: `${hubYears} years`, l: 'Developing factories and consolidating cargo in China' },
      { v: 'ISO 9001', l: 'China HUB, a certified unit since 2001' },
    ],
    route: 'Consolidation · Export',
    marquee: 'Manufacturers we represent in Brazil and Latin America',
    fronts: {
      label: 'How we work',
      title: 'One technical and logistics solution, on two fronts.',
      sub: 'From power semiconductors to custom parts, Mastertronics supplies with local technical support — through the manufacturers we represent or the factories we develop in China.',
      items: [
        {
          photo: 'pcb', n: '01', tag: 'Manufacturer representation',
          title: 'Global manufacturers, local technical support.',
          text: 'We represent international semiconductor and electronic component manufacturers. You buy through the distribution channel or direct from the factory, always with our technical and commercial support.',
          spec: [
            { k: 'Portfolio', v: `Semiconductors and components from ${n} global manufacturers` },
            { k: 'Purchase', v: 'Distribution channel or direct from the factory' },
            { k: 'Mastertronics', v: 'Technical and commercial support, close to your project' },
          ],
          cta: 'See manufacturers', key: 'manufacturers' as const,
        },
        {
          photo: 'port', n: '02', tag: 'China HUB',
          title: 'Factories developed and cargo consolidated in China.',
          text: 'We develop factories in China for the parts your project needs and consolidate the cargo from those factories. Mastertronics is the supplier and exports to you — or the factory exports directly when you buy direct from the factory.',
          spec: [
            { k: 'Factories', v: 'Sourced, audited and qualified by the HUB' },
            { k: 'Logistics', v: 'Cargo consolidation in China' },
            { k: 'Export', v: 'By Mastertronics or direct from the factory' },
          ],
          cta: 'Discover the China HUB', key: 'chinaHub' as const,
        },
      ],
    },
    direct: {
      label: 'Direct from the factory',
      title: 'We are the supplier. And we stand behind every part.',
      p: 'We buy direct from the factory, with no middlemen or brokers. That is why Mastertronics answers for every part it supplies, with three guarantees:',
      items: [
        { i: 'shield', t: 'Warranty', d: 'A warranty on the parts we supply, given by Mastertronics itself.' },
        { i: 'route', t: 'Traceability', d: 'Known origin: every part comes from a factory we have developed and audited.' },
        { i: 'chip', t: 'Technical support', d: 'Technical support on part specification and application, agile and close at hand.' },
      ],
    },
    about: {
      label: 'Mastertronics',
      title: 'Closer to every customer.',
      p1: 'Since 1991, we have been connecting the Latin American electrical and electronics industry with leading global solutions in semiconductors and electronic components. Today we are a technical and logistics solution on several fronts, with agile, close service — anticipating trends and enabling access to emerging technologies.',
      p2: 'Our portfolio includes power semiconductors, memory, custom displays, MEMS sensors, optocouplers and current and voltage sensors for industrial and energy applications.',
      more: 'About the company',
      badge: `${years} years`,
      badgeL: 'connecting industry to global technology',
    },
    mfr: {
      label: 'Portfolio',
      title: 'Our manufacturers',
      sub: 'Global leaders in power semiconductors, memory, sensors, optoelectronics, displays, crystals and magnetics.',
      all: 'See all manufacturers',
    },
    hub: {
      label: 'China HUB',
      title: 'Our arm in China: factories developed, cargo consolidated.',
      p0: 'In 2001 we opened our hub in China to support printed circuit boards, dedicated to developing, auditing and qualifying factories.',
      p: 'Today we develop factories for connectors, custom cables, magnetic components, batteries, custom plastic and metal parts, passive components and low-complexity semiconductors — and consolidate the cargo from those factories in China, all the way to export.',
      steps: ['Request', 'Factory', 'Qualification', 'Consolidation', 'Export'],
      cta: 'How the China HUB works',
      badge: 'Certified unit in China',
      since: 'Since',
    },
    energy: {
      label: 'Renewable energy · Mastertronics & CRRC',
      title: 'CRRC’s scale for Brazil’s energy infrastructure.',
      p: 'A strategic partnership with CRRC’s Times Electric and ZhuZhou Institute Comprehensive Energy divisions: consulting, technical support and complete solutions in generation, storage and green hydrogen.',
      stats: [
        { v: 'Fortune 500', l: 'Global leader' },
        { v: '48+ GWh', l: 'Of BESS deployed · Top 3 worldwide' },
        { v: '70+ GW', l: 'Top 3 in solar inverters in China' },
        { v: 'No. 1', l: 'Wind market in China' },
      ],
      cta: 'Energy solutions',
    },
  },
}[lang];

const mapNodes = [
  { id: 'poa', label: 'Porto Alegre', lon: -51.2, lat: -30.0, kind: 'hq' as const },
  { id: 'uk', label: 'UK', lon: -0.5, lat: 53.2, kind: 'mfr' as const },
  { id: 'tj', label: 'Tianjin', lon: 117.2, lat: 39.1, kind: 'mfr' as const },
  { id: 'nb', label: 'Ningbo', lon: 121.5, lat: 29.9, kind: 'mfr' as const },
  { id: 'tw', label: 'Taiwan', lon: 121.0, lat: 24.2, kind: 'mfr' as const },
  { id: 'zz', label: 'Zhuzhou', lon: 113.1, lat: 27.8, kind: 'mfr' as const },
  { id: 'hub', label: 'China HUB', lon: 113.9, lat: 22.6, kind: 'hub' as const },
];
const marquee = [...manufacturers, ...manufacturers];
---
<Base lang={lang} title={c.meta.title} description={c.meta.desc} alt={lang === 'pt' ? '/en/' : '/'} headerTheme="dark">
  <!-- HERO -->
  <section class="hero dark">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="container hero-in">
      <div class="hero-copy">
        <span class="label reveal">{c.hero.label}</span>
        <h1 class="display reveal" style="--d:.06s">{c.hero.title[0]}<br /><span class="hero-soft">{c.hero.title[1]}</span></h1>
        <p class="lead reveal" style="--d:.14s">{c.hero.sub}</p>
        <div class="hero-ctas reveal" style="--d:.2s">
          <a href={url(lang, 'contact')} class="btn btn--lime">{c.hero.cta1}<Icon name="arrow" /></a>
          <a href="#frentes" class="btn btn--ghost">{c.hero.cta2}</a>
        </div>
      </div>
      <div class="hero-map reveal" style="--d:.25s"><WorldMap nodes={mapNodes} route={c.route} /></div>
    </div>
    <div class="container">
      <dl class="stats">
        {c.stats.map((s, i) => (
          <div class="stat reveal" style={`--d:${0.3 + i * 0.06}s`}>
            <dt class="stat-v">{s.v}</dt>
            <dd class="stat-l">{s.l}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- LOGO MARQUEE -->
  <section class="mq" aria-label={c.marquee}>
    <p class="mq-h mono">{c.marquee}</p>
    <div class="mq-track-wrap">
      <ul class="mq-track">
        {marquee.map((m, i) => (
          <li aria-hidden={i >= manufacturers.length ? 'true' : undefined}>
            <a href={`${url(lang, 'manufacturers')}${m.slug}/`} tabindex={i >= manufacturers.length ? -1 : undefined}>
              <img src={m.logo} alt={i >= manufacturers.length ? '' : m.name} loading="lazy" style={`--s:${m.logoScale ?? 1}`} />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- FRONTS -->
  <section class="section fronts" id="frentes">
    <div class="container">
      <div class="shead shead--split">
        <div>
          <span class="label reveal">{c.fronts.label}</span>
          <h2 class="h2 reveal" style="--d:.05s">{c.fronts.title}</h2>
        </div>
        <p class="lead reveal" style="--d:.1s">{c.fronts.sub}</p>
      </div>
      <div class="fgrid">
        {c.fronts.items.map((f, i) => (
          <article class="front reveal" style={`--d:${i * 0.08}s`}>
            <div class="front-img">
              <Photo name={f.photo} alt="" sizes="(max-width: 900px) 100vw, 50vw" />
              <span class="front-n mono">{f.n}</span>
            </div>
            <div class="front-body">
              <span class="front-tag mono">{f.tag}</span>
              <h3 class="front-title">{f.title}</h3>
              <p class="front-text">{f.text}</p>
              <dl class="front-spec">
                {f.spec.map((r) => <div><dt class="mono">{r.k}</dt><dd>{r.v}</dd></div>)}
              </dl>
              <a href={url(lang, f.key)} class="link-arrow front-cta"><span>{f.cta}</span><Icon name="arrow" /></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- DIRECT FROM THE FACTORY -->
  <section class="section dark direct">
    <div class="container">
      <div class="shead shead--split direct-head">
        <div>
          <span class="label reveal">{c.direct.label}</span>
          <h2 class="h2 reveal" style="--d:.05s">{c.direct.title}</h2>
        </div>
        <p class="lead reveal" style="--d:.1s">{c.direct.p}</p>
      </div>
    </div>
    <Trace class="direct-trace" />
    <div class="container">
      <ol class="direct-list">
        {c.direct.items.map((g, i) => (
          <li class="reveal" style={`--d:${i * 0.08}s`}>
            <span class="direct-ic"><Icon name={g.i as any} size={22} /></span>
            <span class="direct-n mono">0{i + 1}</span>
            <h3 class="h3">{g.t}</h3>
            <p>{g.d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="section white about">
    <div class="container about-grid">
      <div class="about-fig reveal">
        <Photo name="cleanroom" alt="" sizes="(max-width: 900px) 100vw, 50vw" position="35% 50%" />
        <div class="about-badge">
          <strong>{c.about.badge}</strong>
          <span>{c.about.badgeL}</span>
        </div>
      </div>
      <div class="about-copy">
        <span class="label reveal">{c.about.label}</span>
        <h2 class="h2 reveal" style="--d:.05s">{c.about.title}</h2>
        <div class="prose reveal" style="--d:.1s">
          <p class="about-lead">{c.about.p1}</p>
          <p>{c.about.p2}</p>
        </div>
        <a href={url(lang, 'about')} class="btn btn--primary reveal" style="--d:.15s">{c.about.more}<Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- MANUFACTURERS -->
  <section class="section mfr">
    <div class="container">
      <div class="shead shead--row">
        <div>
          <span class="label reveal">{c.mfr.label}</span>
          <h2 class="h2 reveal" style="--d:.05s">{c.mfr.title}</h2>
          <p class="lead reveal" style="--d:.1s">{c.mfr.sub}</p>
        </div>
        <a href={url(lang, 'manufacturers')} class="btn btn--ghost reveal">{c.mfr.all}<Icon name="arrow" /></a>
      </div>
      <div class="lgrid">
        {manufacturers.map((m, i) => <div class="reveal" style={`--d:${(i % 4) * 0.05}s`}><MfrTile m={m} lang={lang} /></div>)}
      </div>
    </div>
  </section>


  <!-- CHINA HUB -->
  <section class="section dark hub">
    <div class="container hub-grid">
      <div class="hub-fig reveal">
        <Photo name="factory" alt="" sizes="(max-width: 900px) 100vw, 45vw" />
        <div class="hub-badge">
          <Icon name="shield" size={26} />
          <div><strong>ISO 9001</strong><span>{c.hub.badge}</span></div>
          <div class="hub-since"><span>{c.hub.since}</span><strong>2001</strong></div>
        </div>
      </div>
      <div class="hub-copy">
        <span class="label reveal">{c.hub.label}</span>
        <h2 class="h2 reveal" style="--d:.05s">{c.hub.title}</h2>
        <div class="hub-p reveal" style="--d:.1s"><p>{c.hub.p0}</p><p>{c.hub.p}</p></div>
        <ol class="hub-steps reveal" style="--d:.14s">
          {c.hub.steps.map((s, i) => <li><span class="mono">0{i + 1}</span>{s}</li>)}
        </ol>
        <a href={url(lang, 'chinaHub')} class="btn btn--lime reveal" style="--d:.18s">{c.hub.cta}<Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- ENERGY -->
  <section class="energy dark">
    <div class="energy-bg" aria-hidden="true"><Photo name="wind" alt="" sizes="100vw" /></div>
    <div class="container energy-in">
      <div class="energy-copy">
        <span class="label reveal">{c.energy.label}</span>
        <h2 class="h2 reveal" style="--d:.05s">{c.energy.title}</h2>
        <p class="lead reveal" style="--d:.1s">{c.energy.p}</p>
        <a href={url(lang, 'renewables')} class="btn btn--lime reveal" style="--d:.15s">{c.energy.cta}<Icon name="arrow" /></a>
      </div>
      <dl class="energy-stats">
        {c.energy.stats.map((s, i) => <div class="reveal" style={`--d:${i * 0.06}s`}><dt>{s.v}</dt><dd>{s.l}</dd></div>)}
      </dl>
    </div>
  </section>

  <ContactSection lang={lang} />
</Base>

<style>
  /* HERO */
  .hero { position: relative; overflow: hidden; padding-top: clamp(130px, 16vw, 180px); padding-bottom: 48px; isolation: isolate; }
  .hero::before { content: ''; position: absolute; inset: 0; z-index: -1; background: radial-gradient(60% 50% at 78% 55%, rgba(222,221,58,.07), transparent 70%), radial-gradient(50% 60% at 10% 0%, rgba(255,255,255,.05), transparent 70%); }
  .hero-grid { position: absolute; inset: 0; z-index: -1; opacity: .5; background-image: linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px); background-size: 72px 72px; mask-image: radial-gradient(80% 70% at 50% 40%, #000 30%, transparent 100%); }
  .hero-in { position: relative; min-height: 560px; }
  .hero-copy { position: relative; z-index: 2; display: grid; gap: 26px; max-width: 880px; }
  .hero-copy .display { font-size: clamp(2.4rem, 4.8vw, 4.2rem); }
  .hero h1 { color: #fff; }
  .hero-soft { color: #8f949b; }
  .hero .lead { max-width: 590px; }
  .hero-ctas { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 6px; }
  .hero-map { position: absolute; z-index: 1; pointer-events: none; width: min(1180px, 88vw); right: calc(var(--gutter) * -1 - 4vw); top: -10px; -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 34%); mask-image: linear-gradient(90deg, transparent 0%, #000 34%); }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line-dark); margin-top: 24px; }
  .stat { padding: 28px 24px 8px 0; display: grid; gap: 6px; align-content: start; }
  .stat + .stat { padding-left: 24px; border-left: 1px solid var(--line-dark); }
  .stat-v { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.75rem, 3vw, 2.5rem); letter-spacing: -0.04em; color: #fff; line-height: 1; }
  .stat-l { font-size: 0.875rem; color: var(--on-dark-muted); }
  @media (max-width: 1100px) { .hero-in { min-height: 0; } .hero-map { position: relative; right: auto; top: auto; width: auto; margin: -40px -8% 0 10%; } }
  @media (max-width: 760px) {
    .hero-map { margin: 28px -18% 0 -6%; -webkit-mask-image: none; mask-image: none; }
    .stats { grid-template-columns: 1fr 1fr; }
    .stat + .stat:nth-child(3) { padding-left: 0; border-left: 0; }
    .stat:nth-child(n+3) { border-top: 1px solid var(--line-dark); }
  }

  /* MARQUEE */
  .mq { background: var(--white); border-bottom: 1px solid var(--line); padding: 34px 0 32px; overflow: hidden; }
  .mq-h { text-align: center; font-size: .6875rem; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); margin-bottom: 22px; padding-inline: var(--gutter); }
  .mq-track-wrap { mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
  .mq-track { list-style: none; padding: 0; display: flex; width: max-content; animation: mq 60s linear infinite; }
  .mq-track-wrap:hover .mq-track { animation-play-state: paused; }
