---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import Distributors from '../components/Distributors.astro';
import ContactSection from '../components/ContactSection.astro';
import { manufacturers } from '../data/manufacturers';
import { type Lang, url, routes } from '../i18n/routes';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const other = lang === 'pt' ? 'en' : 'pt';
const c = {
  pt: {
    label: 'Distribuidores',
    metaTitle: 'Distribuidores · Onde comprar',
    desc: 'Os produtos dos fabricantes representados pela Mastertronics podem ser adquiridos através da Arrow Electronics, Future Electronics, Macnica DHW e Richardson RFPD, com suporte técnico local.',
    h1: 'Onde comprar.<br><em>Com quem você já confia.</em>',
    lead: 'Os produtos dos fabricantes que representamos podem ser adquiridos através de distribuidores globais. Consulte a Mastertronics para descobrir quais linhas de produtos sua empresa pode adquirir através de cada distribuidor parceiro.',
    ben: {
      label: 'Vantagens',
      title: 'O melhor dos dois mundos: escala global e atendimento local.',
      items: [
        { i: 'globe', t: 'Estrutura global', d: 'Estoque, logística e processos de compra de distribuidores reconhecidos mundialmente.' },
        { i: 'chip', t: 'Suporte técnico Mastertronics', d: 'A especificação e o acompanhamento técnico continuam com a nossa equipe, do início ao fim.' },
        { i: 'truck', t: 'Logística integrada', d: 'Soluções logísticas integradas para levar os componentes até a sua linha de produção.' },
        { i: 'shield', t: 'Procedência garantida', d: 'Produtos originais dos fabricantes, adquiridos através de canais oficiais de distribuição.' },
      ],
    },
    cta: { t: 'Qual distribuidor atende a sua linha?', d: 'Informe os fabricantes ou os componentes de interesse e indicamos o canal de compra ideal para a sua empresa.', b: 'Consultar a Mastertronics', m: 'Ver fabricantes' },
    contactTitle: 'Consulte o melhor canal de compra',
    contactIntro: 'Conte-nos quais componentes ou fabricantes sua empresa precisa. Indicamos o distribuidor parceiro que atende cada linha de produtos.',
  },
  en: {
    label: 'Distributors',
    metaTitle: 'Distributors · Where to buy',
    desc: 'Products from the manufacturers represented by Mastertronics are available through Arrow Electronics, Future Electronics, Macnica DHW and Richardson RFPD, with local technical support.',
    h1: 'Where to buy.<br><em>From names you already trust.</em>',
    lead: 'Products from the manufacturers we represent are available through our global distribution partners. Contact Mastertronics to find out which product lines your company can purchase from each distributor.',
    ben: {
      label: 'Benefits',
      title: 'The best of both worlds: global scale and local service.',
      items: [
        { i: 'globe', t: 'Global infrastructure', d: 'Stock, logistics and purchasing processes from world-renowned distributors.' },
        { i: 'chip', t: 'Mastertronics technical support', d: 'Specification and technical follow-up stay with our team, from start to finish.' },
        { i: 'truck', t: 'Integrated logistics', d: 'Integrated logistics solutions that take components all the way to your production line.' },
        { i: 'shield', t: 'Guaranteed origin', d: 'Original products from the manufacturers, purchased through official distribution channels.' },
      ],
    },
    cta: { t: 'Which distributor carries your line?', d: 'Tell us the manufacturers or components you need and we’ll point you to the right purchasing channel.', b: 'Ask Mastertronics', m: 'See manufacturers' },
    contactTitle: 'Find the right purchasing channel',
    contactIntro: 'Tell us which components or manufacturers your company needs. We’ll point you to the distribution partner that carries each product line.',
  },
}[lang];
---
<Base lang={lang} title={c.metaTitle} description={c.desc} alt={routes.distributors[other]}>
  <PageHero label={c.label} title={c.h1} lead={c.lead} crumbs={[{ href: url(lang, 'home'), label: 'Mastertronics' }]} photo="port" />

  <Distributors lang={lang} showLink={false} />

  <section class="section ben">
    <div class="container ben-grid">
      <div class="ben-fig reveal"><Photo name="logistics" alt="" sizes="(max-width: 900px) 100vw, 45vw" /></div>
      <div class="ben-copy">
        <span class="label reveal">{c.ben.label}</span>
        <h2 class="h2 reveal" style="--d:.05s">{c.ben.title}</h2>
        <ul class="ben-list">
          {c.ben.items.map((b, i) => (
            <li class="reveal" style={`--d:${i * 0.05}s`}>
              <span class="ben-ic"><Icon name={b.i as any} size={20} /></span>
              <div><h3 class="h4">{b.t}</h3><p>{b.d}</p></div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section--tight white band">
    <div class="container band-in reveal">
      <div class="band-logos" aria-hidden="true">
        {manufacturers.filter((m) => m.slug !== 'crrc-times-transducer').slice(0, 6).map((m) => <span><img src={m.logo} alt="" loading="lazy" style={`--s:${m.logoScale ?? 1}`} /></span>)}
      </div>
      <div class="band-copy">
        <h2 class="h3">{c.cta.t}</h2>
        <p>{c.cta.d}</p>
        <div class="band-ctas">
          <a href="#contato" class="btn btn--primary">{c.cta.b}<Icon name="arrow" /></a>
          <a href={url(lang, 'manufacturers')} class="btn btn--ghost">{c.cta.m}</a>
        </div>
      </div>
    </div>
  </section>

  <ContactSection lang={lang} topic="manufacturers" title={c.contactTitle} intro={c.contactIntro} />
</Base>

<style>
  .ben-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 7vw, 110px); align-items: center; }
  .ben-fig { border-radius: 22px; overflow: hidden; aspect-ratio: 4 / 5; background: var(--ink); }
  .ben-fig :global(img), .ben-fig :global(.photo-missing) { width: 100%; height: 100%; object-fit: cover; }
  .ben-copy { display: grid; gap: 22px; }
  .ben-list { list-style: none; padding: 0; display: grid; margin-top: 8px; border-top: 1px solid var(--ink); }
  .ben-list li { display: grid; grid-template-columns: 44px 1fr; gap: 18px; padding: 20px 0; border-bottom: 1px solid var(--line); }
  .ben-ic { width: 44px; height: 44px; display: grid; place-items: center; border-radius: 10px; background: var(--white); border: 1px solid var(--line); }
  .ben-list p { color: var(--slate); font-size: .9375rem; margin-top: 4px; }
  @media (max-width: 900px) { .ben-grid { grid-template-columns: 1fr; } .ben-fig { aspect-ratio: 16 / 10; } }

  .band { border-top: 1px solid var(--line); }
  .band-in { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 6vw, 96px); align-items: center; }
  .band-logos { display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--line); border-radius: 18px; overflow: hidden; }
  .band-logos span { display: grid; place-items: center; height: 104px; padding: 18px 22px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .band-logos span:nth-child(3n) { border-right: 0; }
  .band-logos span:nth-child(n+4) { border-bottom: 0; }
  .band-logos img { max-height: calc(34px * var(--s)); max-width: 88%; object-fit: contain; }
  .band-copy { display: grid; gap: 14px; justify-items: start; }
  .band-copy p { color: var(--slate); }
  .band-ctas { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 8px; }
  @media (max-width: 860px) { .band-in { grid-template-columns: 1fr; } }
</style>
