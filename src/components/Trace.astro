---
// Signal trace derived from the logo's ribbon "M": flat → rise → plateau → fall → flat.
interface Props { class?: string; theme?: 'dark' | 'light'; }
const { class: cls, theme = 'dark' } = Astro.props;
const d = 'M0 60 H520 L560 16 H660 L700 60 H1440';
---
<div class:list={['trace', `trace--${theme}`, cls]} aria-hidden="true">
  <svg viewBox="0 0 1440 76" preserveAspectRatio="none">
    <path class="trace-base" d={d} />
    <path class="trace-run" d={d} pathLength="1" />
  </svg>
</div>
<style>
  .trace { height: 56px; }
  .trace svg { width: 100%; height: 100%; overflow: visible; }
  .trace path { fill: none; vector-effect: non-scaling-stroke; }
  .trace-base { stroke: rgba(255, 255, 255, 0.1); stroke-width: 1.5; }
  .trace--light .trace-base { stroke: var(--line-strong); }
  .trace-run { stroke: var(--lime); stroke-width: 2; stroke-linecap: round; stroke-dasharray: 0.08 0.92; animation: trace 7s linear infinite; }
  .trace--light .trace-run { stroke: var(--ink); }
  @keyframes trace { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @media (prefers-reduced-motion: reduce) { .trace-run { animation: none; opacity: 0; } }
</style>
