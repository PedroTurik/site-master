---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import WorldMap from '../components/WorldMap.astro';
import Trace from '../components/Trace.astro';
import Distributors from '../components/Distributors.astro';
import ContactSection from '../components/ContactSection.astro';
import { manufacturers } from '../data/manufacturers';
import { company } from '../data/company';
import { type Lang, url, routes } from '../i18n/routes';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const other = lang === 'pt' ? 'en' : 'pt';
const years = new Date().getFullYear() - company.founded;
const n = manufacturers.length;

const c = {
  pt: {
    metaTitle: 'Empresa · Excelência em Soluções Eletrônicas desde 1991',
    desc: 'Desde 1991, a Mastertronics conecta a indústria eletroeletrônica da América Latina às principais soluções globais em semicondutores e componentes eletrônicos.',
    crumb: 'Empresa',
    h1: 'Excelência em <em>Soluções Eletrônicas</em>',
    lead: 'Fabricantes globais de semicondutores e componentes, desenvolvimento de fornecedores na China e soluções em energia renovável, com suporte técnico local desde 1991.',
    heroCaption: 'Porto Alegre · sede da Mastertronics',
    intro: 'Quem somos',
    text: [
      'Desde 1991, conectamos a indústria eletroeletrônica da América Latina às principais soluções globais em semicondutores e componentes eletrônicos. Representamos fabricantes internacionais com suporte técnico e comercial ágil, próximo e focado nas necessidades dos clientes, antecipando tendências e viabilizando acesso a tecnologias emergentes.',
      'Somos parceiros estratégicos da Arrow Electronics, Future Electronics, Macnica DHW e Richardson RFPD, disponibilizando os produtos dos fabricantes que representamos por meio desses distribuidores globais e garantindo soluções logísticas integradas com suporte técnico especializado.',
      'Nosso portfólio de produtos inclui semicondutores para eletrônica de potência (MOSFETs, IGBTs, SiC, diodos e transistores), memórias NOR e NAND (incluindo SSD, eMMC e UFS) e DRAM (SDRAM, DDR1, DDR2, DDR3(L) e LPDDR), displays customizados (TFT com touchscreen e monocromáticos), sensores MEMS (magnetômetros, acelerômetros, chaves Hall e IMUs), optoacopladores e drivers isolados para IGBT/MOSFET, e sensores de corrente e tensão (Hall e fluxgate) para aplicações industriais e de energia. Também operamos uma unidade ISO 9001 na China (nosso China HUB), dedicada à qualificação de fornecedores alternativos, com foco em confiabilidade e redução de custos.',
      'Em parceria estratégica com o grupo CRRC, oferecemos sistemas completos para energias renováveis, reforçando nosso compromisso com a sustentabilidade e a eletrônica aplicada à geração limpa, ao armazenamento em sistemas BESS e à produção de hidrogênio verde, em linha com as metas de descarbonização.',
    ],
    mosaic: [
      { photo: 'wafer', t: 'Fabricantes globais', k: 'manufacturers' as const },
      { photo: 'qualification', t: 'China HUB', k: 'chinaHub' as const },
      { photo: 'wind-fog', t: 'Energia renovável', k: 'renewables' as const },
    ],
    nums: [
      { v: '1991', l: 'Ano de fundação' },
      { v: String(n), l: 'Fabricantes globais' },
      { v: '4', l: 'Distribuidores globais parceiros' },
      { v: 'ISO 9001', l: 'Unidade própria na China' },
      { v: 'CRRC', l: 'Parceira estratégica em energia' },
    ],
    diff: {
      label: 'Diferenciais',
      title: 'Por que empresas de toda a América Latina escolhem a Mastertronics.',
      items: [
        { i: 'users', t: 'Relacionamento de longo prazo', d: `${years} anos ao lado da indústria eletroeletrônica, acompanhando cada projeto do desenvolvimento à produção.` },
        { i: 'chip', t: 'Suporte técnico especializado', d: 'Apoio à especificação e à aplicação dos componentes, com agilidade e proximidade.' },
        { i: 'layers', t: 'Fabricantes de referência', d: 'Portfólio com líderes globais em potência, memórias, sensores, optoeletrônica, displays e magnéticos.' },
        { i: 'truck', t: 'Distribuidores globais', d: 'Compra através de Arrow, Future, Macnica DHW e Richardson RFPD, com logística integrada.' },
        { i: 'shield', t: 'Presença na China', d: 'Unidade ISO 9001 para desenvolver e qualificar fornecedores alternativos, com foco em confiabilidade e custo.' },
        { i: 'sun', t: 'Soluções em energia', d: 'Sistemas completos para geração, armazenamento BESS e hidrogênio verde, com a tecnologia CRRC.' },
      ],
    },
    presence: {
      label: 'Presença global',
      title: 'Do Brasil para os principais polos de tecnologia do mundo.',
      p: 'Nossa sede em Porto Alegre atende clientes em todo o Brasil e na América Latina, conectados a fabricantes na Ásia e na Europa e ao nosso China HUB.',
      list: [
        { k: 'Sede', v: 'Porto Alegre · RS · Brasil' },
        { k: 'Atendimento', v: 'Brasil e América Latina' },
        { k: 'China HUB', v: 'Unidade ISO 9001 na China' },
        { k: 'Fabricantes', v: 'Taiwan, China, Hong Kong e Reino Unido' },
      ],
    },
  },
  en: {
    metaTitle: 'Company · Excellence in Electronic Solutions since 1991',
    desc: 'Since 1991, Mastertronics has connected Latin America’s electrical and electronics industry with leading global solutions in semiconductors and electronic components.',
    crumb: 'Company',
    h1: 'Excellence in <em>Electronic Solutions</em>',
    lead: 'Global semiconductor and component manufacturers, supplier development in China and renewable energy solutions, with local technical support since 1991.',
    heroCaption: 'Porto Alegre · Mastertronics headquarters',
    intro: 'Who we are',
    text: [
      'Since 1991, we have been connecting the Latin American electrical and electronics industry with leading global solutions in semiconductors and electronic components. We represent international manufacturers with agile, close technical and commercial support focused on customer needs — anticipating trends and enabling access to emerging technologies.',
      'We are strategic partners of Arrow Electronics, Future Electronics, Macnica DHW and Richardson RFPD, making our manufacturers’ products available through these global distributors and ensuring integrated logistics solutions with specialized technical support.',
      'Our product portfolio includes semiconductors for power electronics (MOSFETs, IGBTs, SiC, diodes and transistors), NOR and NAND flash memories (including SSD, eMMC and UFS) and DRAM (SDRAM, DDR1, DDR2, DDR3(L) and LPDDR), custom displays (TFT with touchscreen and monochrome), MEMS sensors (magnetometers, accelerometers, Hall switches and IMUs), optocouplers and isolated IGBT/MOSFET gate drivers, and current and voltage sensors (Hall and fluxgate) for industrial and energy applications. We also operate an ISO 9001-certified unit in China (our China HUB), dedicated to qualifying alternative suppliers with a focus on reliability and cost reduction.',
      'In strategic partnership with the CRRC group, we offer complete renewable energy systems, reinforcing our commitment to sustainability and to electronics applied to clean energy generation, BESS storage and green hydrogen production, in line with decarbonization goals.',
    ],
    mosaic: [
      { photo: 'wafer', t: 'Global manufacturers', k: 'manufacturers' as const },
      { photo: 'qualification', t: 'China HUB', k: 'chinaHub' as const },
      { photo: 'wind-fog', t: 'Renewable energy', k: 'renewables' as const },
    ],
    nums: [
      { v: '1991', l: 'Year founded' },
      { v: String(n), l: 'Global manufacturers' },
      { v: '4', l: 'Global distribution partners' },
      { v: 'ISO 9001', l: 'Our own unit in China' },
      { v: 'CRRC', l: 'Strategic energy partner' },
    ],
    diff: {
      label: 'Why us',
      title: 'Why companies across Latin America choose Mastertronics.',
      items: [
        { i: 'users', t: 'Long-term relationships', d: `${years} years alongside the electronics industry, with long-term support for every project.` },
        { i: 'chip', t: 'Specialized technical support', d: 'Support with component specification and application, with agility and a close relationship.' },
        { i: 'layers', t: 'Leading manufacturers', d: 'A portfolio of global leaders in power, memory, sensors, optoelectronics, displays and magnetics.' },
        { i: 'truck', t: 'Global distributors', d: 'Purchase through Arrow, Future, Macnica DHW and Richardson RFPD, with integrated logistics.' },
        { i: 'shield', t: 'Presence in China', d: 'An ISO 9001 unit to develop and qualify alternative suppliers, focused on reliability and cost.' },
        { i: 'sun', t: 'Energy solutions', d: 'Complete systems for generation, BESS storage and green hydrogen, with CRRC technology.' },
      ],
    },
    presence: {
      label: 'Global presence',
      title: 'From Brazil to the world’s leading technology hubs.',
      p: 'Our headquarters in Porto Alegre serves customers across Brazil and Latin America, connected to manufacturers in Asia and Europe and to our China HUB.',
      list: [
        { k: 'Headquarters', v: 'Porto Alegre · RS · Brazil' },
        { k: 'Coverage', v: 'Brazil and Latin America' },
        { k: 'China HUB', v: 'ISO 9001 unit in China' },
        { k: 'Manufacturers', v: 'Taiwan, China, Hong Kong and the UK' },
      ],
    },
  },
}[lang];

const nodes = [
  { id: 'poa', label: 'Porto Alegre', lon: -51.2, lat: -30.0, kind: 'hq' as const },
  { id: 'uk', label: 'UK', lon: -0.5, lat: 53.2, kind: 'mfr' as const },
  { id: 'tj', label: 'Tianjin', lon: 117.2, lat: 39.1, kind: 'mfr' as const },
  { id: 'nb', label: 'Ningbo', lon: 121.5, lat: 29.9, kind: 'mfr' as const },
  { id: 'tw', label: 'Taiwan', lon: 121.0, lat: 24.2, kind: 'mfr' as const },
  { id: 'hk', label: 'Hong Kong', lon: 114.2, lat: 22.3, kind: 'mfr' as const },
  { id: 'hub', label: 'China HUB', lon: 112.8, lat: 24.0, kind: 'hub' as const },
];
---
<Base lang={lang} title={c.metaTitle} description={c.desc} alt={routes.about[other]} headerTheme="dark">
  <section class="ahero dark">
    <div class="ahero-bg" aria-hidden="true"><Photo name="porto-alegre" alt="" sizes="100vw" eager /></div>
    <div class="container ahero-in">
      <nav class="crumbs mono reveal" aria-label={lang === 'pt' ? 'Trilha de navegação' : 'Breadcrumb'}>
        <a href={url(lang, 'home')}>Mastertronics</a><span aria-hidden="true">/</span><span aria-current="page">{c.crumb}</span>
      </nav>
      <h1 class="h1 reveal" style="--d:.05s" set:html={c.h1} />
      <p class="lead reveal" style="--d:.1s">{c.lead}</p>
      <p class="ahero-cap mono reveal" style="--d:.15s">{c.heroCaption}</p>
    </div>
    <Trace />
  </section>

  <section class="section white intro">
    <div class="container intro-grid">
      <div class="intro-l">
        <span class="label reveal">{c.intro}</span>
        <p class="intro-lead reveal" style="--d:.05s">{c.text[0]}</p>
      </div>
      <div class="intro-r prose">
        {c.text.slice(1).map((p, i) => <p class="reveal" style={`--d:${i * 0.05}s`}>{p}</p>)}
      </div>
    </div>
    <div class="container">
      <div class="mosaic">
        {c.mosaic.map((m, i) => (
          <a href={url(lang, m.k)} class="mos reveal" style={`--d:${i * 0.07}s`}>
            <Photo name={m.photo} alt="" sizes="(max-width: 760px) 100vw, 33vw" />
            <span class="mos-cap"><span>{m.t}</span><Icon name="arrow" size={18} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="nums dark">
    <div class="container">
      <dl class="nums-grid">
        {c.nums.map((x, i) => <div class="reveal" style={`--d:${i * 0.05}s`}><dt>{x.v}</dt><dd>{x.l}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="section diff">
    <div class="container">
      <div class="head">
        <span class="label reveal">{c.diff.label}</span>
        <h2 class="h2 reveal" style="--d:.05s">{c.diff.title}</h2>
      </div>
      <ul class="dgrid6">
        {c.diff.items.map((d, i) => (
          <li class="reveal" style={`--d:${(i % 3) * 0.06}s`}>
            <span class="d-ic"><Icon name={d.i as any} size={22} /></span>
            <h3 class="h4">{d.t}</h3>
            <p>{d.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section white presence">
    <div class="container pres-grid">
      <div class="pres-copy">
        <span class="label reveal">{c.presence.label}</span>
        <h2 class="h2 reveal" style="--d:.05s">{c.presence.title}</h2>
        <p class="lead reveal" style="--d:.1s">{c.presence.p}</p>
        <dl class="pres-list reveal" style="--d:.14s">
          {c.presence.list.map((x) => <div><dt class="mono">{x.k}</dt><dd>{x.v}</dd></div>)}
        </dl>
      </div>
      <div class="pres-map reveal" style="--d:.1s"><WorldMap nodes={nodes} labelScale={1.9} /></div>
    </div>
  </section>

  <Distributors lang={lang} />
  <ContactSection lang={lang} />
</Base>

<style>
  .ahero { position: relative; overflow: hidden; isolation: isolate; min-height: min(86vh, 780px); display: flex; flex-direction: column; justify-content: flex-end; padding-top: 160px; }
  .ahero-bg { position: absolute; inset: 0; z-index: -1; }
  .ahero-bg :global(img), .ahero-bg :global(.photo-missing) { width: 100%; height: 100%; object-fit: cover; }
  .ahero-bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(20,22,25,.9) 0%, rgba(20,22,25,.6) 50%, rgba(20,22,25,.2) 100%), linear-gradient(0deg, rgba(20,22,25,.95) 0%, transparent 50%); }
  .ahero-in { display: grid; gap: 22px; justify-items: start; padding-bottom: clamp(48px, 6vw, 80px); }
  .ahero h1 { color: #fff; max-width: 14ch; }
  .ahero h1 :global(em) { font-style: normal; color: #a4a9af; }
  .ahero .lead { max-width: 56ch; color: #c9ccd0; }
  .ahero-cap { font-size: .6875rem; text-transform: uppercase; letter-spacing: .07em; color: #8f949b; }
  .crumbs { display: flex; gap: 10px; font-size: .75rem; text-transform: uppercase; letter-spacing: .06em; color: var(--on-dark-muted); }
  .crumbs a:hover { color: #fff; }
  .crumbs [aria-current] { color: var(--lime); }

  .intro-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 7vw, 110px); align-items: start; }
  .intro-l { display: grid; gap: 22px; position: sticky; top: 110px; }
  .intro-lead { font-family: var(--font-display); font-size: clamp(1.4rem, 2.2vw, 1.875rem); line-height: 1.3; letter-spacing: -.025em; font-weight: 500; text-wrap: pretty; }
  @media (max-width: 900px) { .intro-grid { grid-template-columns: 1fr; } .intro-l { position: static; } }

  .mosaic { display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 14px; margin-top: clamp(56px, 7vw, 96px); }
  .mos { position: relative; display: block; border-radius: 18px; overflow: hidden; aspect-ratio: 4 / 5; background: var(--ink); }
  .mos:first-child { aspect-ratio: auto; }
  .mos :global(img), .mos :global(.photo-missing) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease); }
  .mos:hover :global(img) { transform: scale(1.05); }
  .mos::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(20,22,25,.75), transparent 45%); }
  .mos-cap { position: absolute; z-index: 1; left: 20px; right: 20px; bottom: 18px; display: flex; justify-content: space-between; align-items: center; color: #fff; font-family: var(--font-display); font-weight: 600; font-size: 1.25rem; letter-spacing: -.02em; }
  .mos-cap :global(svg) { transition: transform .3s var(--ease); }
  .mos:hover .mos-cap :global(svg) { transform: translateX(4px); }
  @media (max-width: 760px) { .mosaic { grid-template-columns: 1fr; } .mos, .mos:first-child { aspect-ratio: 16 / 10; } }

  .nums { padding-block: clamp(48px, 6vw, 72px); }
  .nums-grid { display: grid; grid-template-columns: repeat(5, 1fr); }
  .nums-grid div { display: grid; gap: 8px; padding-right: 20px; align-content: start; }
  .nums-grid div + div { padding-left: 24px; border-left: 1px solid var(--line-dark); }
  .nums-grid dt { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.75rem, 3vw, 2.5rem); letter-spacing: -.04em; line-height: 1; color: #fff; white-space: nowrap; }
  .nums-grid dd { font-size: .875rem; color: var(--on-dark-muted); }
  @media (max-width: 900px) {
    .nums-grid { grid-template-columns: 1fr 1fr; row-gap: 28px; }
    .nums-grid div + div { padding-left: 0; border-left: 0; }
  }

  .head { display: grid; gap: 18px; max-width: 780px; margin-bottom: 52px; }
  .dgrid6 { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .dgrid6 li { display: grid; gap: 10px; align-content: start; padding: 28px; border-radius: 18px; background: var(--white); border: 1px solid var(--line); transition: box-shadow .35s, border-color .35s; }
  .dgrid6 li:hover { box-shadow: var(--shadow-1); border-color: var(--line-strong); }
  .d-ic { width: 46px; height: 46px; display: grid; place-items: center; border-radius: 12px; background: var(--ink); color: var(--lime); margin-bottom: 10px; }
  .dgrid6 p { color: var(--slate); font-size: .9375rem; }
  @media (max-width: 960px) { .dgrid6 { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .dgrid6 { grid-template-columns: 1fr; } }

  .pres-grid { display: grid; grid-template-columns: 1fr 1.25fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .pres-copy { display: grid; gap: 20px; }
  .pres-list { display: grid; margin-top: 8px; border-top: 1px solid var(--ink); }
  .pres-list div { display: grid; grid-template-columns: 130px 1fr; gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--line); }
  .pres-list dt { font-size: .6875rem; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); padding-top: 3px; }
  .pres-list dd { font-weight: 550; }
  .pres-map { background: radial-gradient(60% 70% at 70% 40%, rgba(222,221,58,.08), transparent 70%), var(--ink); border-radius: 22px; padding: clamp(20px, 3vw, 40px) clamp(12px, 2vw, 24px); }
  @media (max-width: 960px) { .pres-grid { grid-template-columns: 1fr; } }
</style>
