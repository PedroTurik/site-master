---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Trace from '../components/Trace.astro';
import Photo from '../components/Photo.astro';
import ContactSection from '../components/ContactSection.astro';
import { type Lang, url, routes, mfrUrl } from '../i18n/routes';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const other = lang === 'pt' ? 'en' : 'pt';

const c = {
  pt: {
    metaTitle: 'Energia renovável · Mastertronics & CRRC',
    desc: 'Sistemas completos para energias renováveis, em parceria estratégica entre a Mastertronics e a CRRC: geração solar e eólica, armazenamento BESS e hidrogênio verde no Brasil e na América Latina.',
    crumb: 'Energia renovável',
    tag: 'Mastertronics & CRRC',
    h1: 'Energia limpa com tecnologia global <em>e presença local.</em>',
    lead: 'Sistemas completos para geração solar e eólica, armazenamento em baterias (BESS) e hidrogênio verde, com a tecnologia e a escala da CRRC, líder global da Fortune 500, e o suporte técnico local da Mastertronics.',
    cta: 'Inicie sua parceria',
    partner: {
      label: 'Parceria estratégica',
      title: 'Mastertronics & CRRC',
      p1: 'A Mastertronics é parceira estratégica das divisões Times Electric e ZhuZhou Institute Comprehensive Energy da CRRC no Brasil. Oferecemos consultoria, suporte técnico e apoio à construção de parcerias nos segmentos de geração (solar e eólica), armazenamento (BESS) e novas energias (hidrogênio verde).',
      p2: 'Garantimos acesso direto a tecnologias avançadas, soluções completas e suporte técnico local para a América Latina, com foco em inovação e competitividade.',
      services: ['Consultoria', 'Suporte técnico', 'Construção de parcerias'],
      caption: 'Aerogerador offshore CRRC',
    },
    segs: {
      label: 'Segmentos',
      title: 'Sistemas completos, da geração ao armazenamento.',
      items: [
        { i: 'sun', p: 'solar', k: 'Geração', t: 'Solar', d: 'Inversores e sistemas para usinas e geração distribuída.' },
        { i: 'wind', p: 'wind', k: 'Geração', t: 'Eólica', d: 'Aerogeradores e sistemas de conversão para parques eólicos.' },
        { i: 'battery', p: 'bess', k: 'Armazenamento', t: 'BESS', d: 'Sistemas de armazenamento de energia em baterias.' },
        { i: 'drop', p: 'power', k: 'Novas energias', t: 'Hidrogênio verde', d: 'Retificadores, eletrolisadores e gestão energética.' },
      ],
    },
    cred: {
      label: 'CRRC',
      title: 'Credenciais e capacidade industrial',
      stats: [
        { v: 'Fortune 500', l: 'Líder global com faturamento multibilionário' },
        { v: '65 anos', l: 'De inovação e desenvolvimento no ZhuZhou Institute' },
        { v: '+70 GW', l: 'Top 3 no mercado chinês de inversores solares' },
        { v: '+100 mil', l: 'Geradores produzidos · Top 1 eólico na China' },
        { v: '+48 GWh', l: 'Em BESS implantados · Top 3 global' },
      ],
      cards: [
        { t: 'Escala global', p: ['A CRRC é líder global e está classificada na Fortune 500, com faturamento multibilionário.', 'Com 65 anos de experiência em inovação e desenvolvimento através do ZhuZhou Institute, a empresa domina uma produção verticalizada de alta tecnologia, desde semicondutores de potência até sistemas completos de energia limpa e armazenamento BESS.'] },
        { t: 'Energias renováveis', p: ['No setor de energia solar, a CRRC é Top 3 no mercado chinês de inversores, com mais de 70 GW de capacidade instalada.', 'No mercado eólico, é Top 1 na China, com mais de 100 mil geradores produzidos. No armazenamento de energia (BESS), ocupa posição Top 3 global, com mais de 48 GWh implantados ao redor do mundo.'] },
        { t: 'Inovação em hidrogênio', p: ['A CRRC lidera a produção de hidrogênio verde na China, com foco em retificadores com tecnologia IGBT, eletrolisadores de alta capacidade (sistemas PEM e alcalinos) e sistemas de gestão energética.'] },
      ],
    },
    comp: {
      label: 'Também no nosso portfólio',
      title: 'Componentes CRRC para a sua eletrônica de potência',
      p: 'Além dos sistemas completos, representamos duas empresas do grupo CRRC para projetos de eletrônica de potência e sensoriamento.',
      a: { t: 'CRRC Times Semiconductor', d: 'IGBT, FRD, tiristores, IGCT e SiC' },
      b: { t: 'CRRC Times Transducer', d: 'Sensores de corrente e tensão Hall e fluxgate' },
    },
    contactTitle: 'Inicie sua parceria',
    contactIntro: 'A Mastertronics e a CRRC estão posicionadas para impulsionar a infraestrutura de energia renovável da sua empresa no Brasil. Para discutir a aplicação específica de nossas tecnologias em seus projetos, entre em contato com nossa área comercial.',
  },
  en: {
    metaTitle: 'Renewable energy · Mastertronics & CRRC',
    desc: 'Complete renewable energy systems, through the strategic partnership between Mastertronics and CRRC: solar and wind generation, BESS storage and green hydrogen in Brazil and Latin America.',
    crumb: 'Renewable energy',
    tag: 'Mastertronics & CRRC',
    h1: 'Clean energy with global technology <em>and local presence.</em>',
    lead: 'Complete systems for solar and wind generation, battery energy storage (BESS) and green hydrogen, with the technology and scale of CRRC, a Fortune 500 global leader, and Mastertronics’ local technical support.',
    cta: 'Start your partnership',
    partner: {
      label: 'Strategic partnership',
      title: 'Mastertronics & CRRC',
      p1: 'Mastertronics is a strategic partner of CRRC’s Times Electric and ZhuZhou Institute Comprehensive Energy divisions in Brazil. We offer consulting, technical support and assistance in building partnerships in energy generation (solar and wind), storage (BESS) and new energies (green hydrogen).',
      p2: 'We provide direct access to advanced technologies, complete solutions and local technical support for Latin American customers, with a focus on innovation and competitiveness.',
      services: ['Consulting', 'Technical support', 'Partnership building'],
      caption: 'CRRC offshore wind turbine',
    },
    segs: {
      label: 'Segments',
      title: 'Complete systems, from generation to storage.',
      items: [
        { i: 'sun', p: 'solar', k: 'Generation', t: 'Solar', d: 'Inverters and systems for utility-scale and distributed generation.' },
        { i: 'wind', p: 'wind', k: 'Generation', t: 'Wind', d: 'Wind turbines and conversion systems for wind farms.' },
        { i: 'battery', p: 'bess', k: 'Storage', t: 'BESS', d: 'Battery energy storage systems.' },
        { i: 'drop', p: 'power', k: 'New energies', t: 'Green hydrogen', d: 'Rectifiers, electrolyzers and energy management.' },
      ],
    },
    cred: {
      label: 'CRRC',
      title: 'Credentials and manufacturing capacity',
      stats: [
        { v: 'Fortune 500', l: 'Global leader with multibillion-dollar revenue' },
        { v: '65 years', l: 'Of innovation and development at the ZhuZhou Institute' },
        { v: '70+ GW', l: 'Top 3 in the Chinese solar inverter market' },
        { v: '100k+', l: 'Generators produced · No. 1 in wind in China' },
        { v: '48+ GWh', l: 'Of BESS deployed · Top 3 worldwide' },
      ],
      cards: [
        { t: 'Global scale', p: ['CRRC is a global leader ranked in the Fortune 500, with multibillion-dollar revenue.', 'With 65 years of experience in innovation and development through the ZhuZhou Institute, the company masters a vertically integrated high-tech production process — from power semiconductors to complete clean energy systems and BESS storage solutions.'] },
        { t: 'Renewable energy', p: ['In the solar energy sector, CRRC ranks among the Top 3 in the Chinese inverter market, with over 70 GW of installed capacity. In the wind energy market, it holds the Top 1 position in China, with more than 100,000 generators produced.', 'In energy storage (BESS), it occupies a Top 3 global position, with over 48 GWh deployed worldwide.'] },
        { t: 'Innovation in hydrogen', p: ['CRRC leads the production of green hydrogen in China, focusing on rectifiers with IGBT technology, high-capacity electrolyzers (PEM and Alkaline systems), and energy management systems.'] },
      ],
    },
    comp: {
      label: 'Also in our portfolio',
      title: 'CRRC components for your power electronics',
      p: 'Beyond complete systems, we represent two CRRC group companies for power electronics and sensing projects.',
      a: { t: 'CRRC Times Semiconductor', d: 'IGBT, FRD, thyristors, IGCT and SiC' },
      b: { t: 'CRRC Times Transducer', d: 'Hall and fluxgate current and voltage sensors' },
    },
    contactTitle: 'Start your partnership',
    contactIntro: 'Mastertronics and CRRC are ready to boost your company’s renewable energy infrastructure in Brazil. Please contact our commercial team to discuss the specific application of our technologies in your renewable projects.',
  },
}[lang];
---
<Base lang={lang} title={c.metaTitle} description={c.desc} alt={routes.renewables[other]} headerTheme="dark">
  <section class="rhero dark">
    <div class="rhero-bg" aria-hidden="true">
      <Photo name="wind-fog" alt="" sizes="100vw" eager position="70% 50%" />
    </div>
    <div class="container rhero-in">
      <nav class="crumbs mono reveal" aria-label={lang === 'pt' ? 'Trilha de navegação' : 'Breadcrumb'}>
        <a href={url(lang, 'home')}>Mastertronics</a><span aria-hidden="true">/</span><span aria-current="page">{c.crumb}</span>
      </nav>
      <span class="rtag mono reveal"><span class="rdot"></span>{c.tag}</span>
      <h1 class="h1 reveal" style="--d:.05s" set:html={c.h1} />
      <p class="lead reveal" style="--d:.1s">{c.lead}</p>
      <a href="#contato" class="btn btn--lime reveal" style="--d:.15s">{c.cta}<Icon name="arrow" /></a>
    </div>
    <Trace />
  </section>

  <section class="section white partner">
    <div class="container partner-grid">
      <div class="partner-copy">
        <span class="label reveal">{c.partner.label}</span>
        <h2 class="h2 reveal" style="--d:.05s">{c.partner.title}</h2>
        <div class="prose reveal" style="--d:.1s">
          <p class="plead">{c.partner.p1}</p>
          <p>{c.partner.p2}</p>
        </div>
        <ul class="svc reveal" style="--d:.14s">{c.partner.services.map((s) => <li><Icon name="check" size={16} />{s}</li>)}</ul>
      </div>
      <figure class="partner-fig reveal" style="--d:.1s">
        <Photo name="crrc-turbine" alt={c.partner.caption} sizes="(max-width: 900px) 100vw, 45vw" position="55% 50%" />
        <figcaption class="mono">{c.partner.caption}</figcaption>
      </figure>
    </div>
  </section>

  <section class="section segs">
    <div class="container">
      <div class="head">
        <span class="label reveal">{c.segs.label}</span>
        <h2 class="h2 reveal" style="--d:.05s">{c.segs.title}</h2>
      </div>
      <ul class="seg-grid">
        {c.segs.items.map((s, i) => (
          <li class="reveal" style={`--d:${i * 0.06}s`}>
            <div class="seg-img"><Photo name={s.p} alt="" sizes="(max-width: 520px) 100vw, (max-width: 980px) 50vw, 25vw" /></div>
            <div class="seg-body">
              <span class="seg-top"><span class="seg-k mono">{s.k}</span><span class="seg-ic"><Icon name={s.i as any} size={18} /></span></span>
              <h3 class="h3">{s.t}</h3>
              <p>{s.d}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section dark cred">
    <div class="container">
      <div class="head">
        <span class="label reveal">{c.cred.label}</span>
        <h2 class="h2 reveal" style="--d:.05s">{c.cred.title}</h2>
      </div>
      <dl class="cstats">
        {c.cred.stats.map((s, i) => <div class="reveal" style={`--d:${i * 0.05}s`}><dt>{s.v}</dt><dd>{s.l}</dd></div>)}
      </dl>
      <div class="ccards">
        {c.cred.cards.map((cd, i) => (
          <article class="reveal" style={`--d:${i * 0.06}s`}>
            <span class="mono cc-n">0{i + 1}</span>
            <h3 class="h3">{cd.t}</h3>
            {cd.p.map((p) => <p>{p}</p>)}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section--tight white comp">
    <div class="container comp-grid">
      <div>
        <span class="label reveal">{c.comp.label}</span>
        <h2 class="h3 reveal" style="--d:.05s">{c.comp.title}</h2>
        <p class="muted reveal" style="--d:.1s">{c.comp.p}</p>
      </div>
      <div class="comp-links">
        <a href={mfrUrl(lang, 'crrc-times-semiconductor')} class="reveal"><img src="/logos/crrc-tsc.png" alt="" /><span><strong>{c.comp.a.t}</strong><em>{c.comp.a.d}</em></span><Icon name="arrow" /></a>
        <a href={mfrUrl(lang, 'crrc-times-transducer')} class="reveal" style="--d:.06s"><img src="/logos/crrc-sensor.png" alt="" /><span><strong>{c.comp.b.t}</strong><em>{c.comp.b.d}</em></span><Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <ContactSection lang={lang} topic="renewables" title={c.contactTitle} intro={c.contactIntro} />
</Base>

<style>
  .rhero { position: relative; overflow: hidden; padding-top: clamp(140px, 16vw, 220px); isolation: isolate; min-height: min(92vh, 860px); display: flex; flex-direction: column; justify-content: flex-end; }
  .rhero-bg { position: absolute; inset: 0; z-index: -1; }
  .rhero-bg :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .rhero-bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(20,22,25,.96) 0%, rgba(20,22,25,.82) 42%, rgba(20,22,25,.25) 100%), linear-gradient(0deg, rgba(20,22,25,1) 0%, transparent 40%); }
  .rhero-in { display: grid; gap: 22px; justify-items: start; padding-bottom: clamp(48px, 6vw, 88px); }
  .rhero h1 { color: #fff; max-width: 15ch; }
  .rhero h1 :global(em) { font-style: normal; color: #a4a9af; }
  .rhero .lead { max-width: 58ch; color: #c3c6cb; }
  .crumbs { display: flex; gap: 10px; font-size: .75rem; text-transform: uppercase; letter-spacing: .06em; color: var(--on-dark-muted); }
  .crumbs a:hover { color: #fff; }
  .crumbs [aria-current] { color: var(--lime); }
  .rtag { display: inline-flex; gap: 10px; align-items: center; font-size: .75rem; text-transform: uppercase; letter-spacing: .06em; color: var(--on-dark); padding: 7px 12px 6px; border-radius: 999px; border: 1px solid rgba(255,255,255,.18); background: rgba(20,22,25,.4); backdrop-filter: blur(6px); }
  .rdot { width: 7px; height: 7px; border-radius: 50%; background: var(--lime); box-shadow: 0 0 0 3px var(--lime-glow); }

  .partner-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 7vw, 110px); align-items: center; }
  .partner-copy { display: grid; gap: 22px; }
  .plead { color: var(--ink) !important; font-size: 1.1875rem !important; }
  .svc { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .svc li { display: inline-flex; gap: 8px; align-items: center; padding: 9px 14px; border-radius: 999px; background: var(--paper); border: 1px solid var(--line); font-size: .875rem; font-weight: 500; }
  .svc :global(svg) { color: var(--lime-ink); }
  .partner-fig { position: relative; border-radius: 20px; overflow: hidden; aspect-ratio: 1; }
  .partner-fig :global(img), .partner-fig :global(.photo-missing) { width: 100%; height: 100%; object-fit: cover; }
  .partner-fig figcaption { position: absolute; left: 16px; bottom: 16px; font-size: .6875rem; text-transform: uppercase; letter-spacing: .06em; color: #fff; padding: 6px 10px 5px; border-radius: 999px; background: rgba(20,22,25,.55); backdrop-filter: blur(6px); }
  @media (max-width: 900px) { .partner-grid { grid-template-columns: 1fr; } .partner-fig { aspect-ratio: 16 / 10; } }

  .head { display: grid; gap: 18px; max-width: 760px; margin-bottom: 52px; }
  .cred h2 { color: #fff; }
  .seg-grid { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .seg-grid li { display: grid; grid-template-rows: auto 1fr; border-radius: 18px; overflow: hidden; background: var(--white); border: 1px solid var(--line); transition: box-shadow .35s, transform .35s var(--ease); }
  .seg-img { aspect-ratio: 4 / 3; overflow: hidden; background: var(--ink); }
  .seg-img :global(img), .seg-img :global(.photo-missing) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease); }
  .seg-grid li:hover .seg-img :global(img) { transform: scale(1.05); }
  .seg-body { display: grid; gap: 10px; align-content: start; padding: 22px 24px 26px; }
  .seg-top { display: flex; justify-content: space-between; align-items: center; }
  .seg-grid li:hover { box-shadow: var(--shadow-2); transform: translateY(-2px); }
  .seg-k { font-size: .6875rem; text-transform: uppercase; letter-spacing: .07em; color: var(--muted); }
  .seg-ic { width: 34px; height: 34px; display: grid; place-items: center; border-radius: 9px; background: var(--ink); color: var(--lime); }
  .seg-grid h3 { margin-top: 6px; }
  .seg-grid p { color: var(--slate); font-size: .9375rem; }
  @media (max-width: 980px) { .seg-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .seg-grid { grid-template-columns: 1fr; } }

  .cstats { display: grid; grid-template-columns: repeat(5, 1fr); border-top: 1px solid var(--line-dark); border-bottom: 1px solid var(--line-dark); }
  .cstats div { padding: 28px 20px 28px 0; display: grid; gap: 10px; align-content: start; }
  .cstats div + div { padding-left: 20px; border-left: 1px solid var(--line-dark); }
  .cstats dt { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.5rem, 2.6vw, 2.25rem); letter-spacing: -.04em; line-height: 1; color: #fff; white-space: nowrap; }
  .cstats dd { font-size: .875rem; color: var(--on-dark-muted); }
  @media (max-width: 1060px) {
    .cstats { grid-template-columns: repeat(3, 1fr); }
    .cstats div + div:nth-child(4) { padding-left: 0; border-left: 0; }
    .cstats div:nth-child(n+4) { border-top: 1px solid var(--line-dark); }
  }
  @media (max-width: 620px) {
    .cstats { grid-template-columns: 1fr 1fr; }
    .cstats div + div { padding-left: 20px; border-left: 1px solid var(--line-dark); }
    .cstats div + div:nth-child(odd) { padding-left: 0; border-left: 0; }
    .cstats div:nth-child(n+3) { border-top: 1px solid var(--line-dark); }
    .cstats div + div:nth-child(4) { padding-left: 20px; border-left: 1px solid var(--line-dark); }
  }
  .ccards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 48px; }
  .ccards article { display: grid; gap: 14px; align-content: start; padding: 28px; border-radius: 18px; background: rgba(255,255,255,.035); border: 1px solid var(--line-dark); }
  .cc-n { color: var(--lime); font-size: .75rem; }
  .ccards h3 { color: #fff; }
  .ccards p { font-size: .9375rem; line-height: 1.65; }
  @media (max-width: 900px) { .ccards { grid-template-columns: 1fr; } }

  .comp { border-top: 1px solid var(--line); }
  .comp-grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(32px, 6vw, 96px); align-items: center; }
  .comp-grid > div:first-child { display: grid; gap: 14px; }
  .comp-links { display: grid; gap: 12px; }
  .comp-links a { display: grid; grid-template-columns: 110px 1fr 20px; gap: 20px; align-items: center; padding: 20px 22px; border-radius: 14px; border: 1px solid var(--line); background: var(--paper); transition: background .3s, border-color .3s; }
  .comp-links a:hover { background: var(--white); border-color: var(--ink); }
  .comp-links img { max-height: 34px; width: auto; }
  .comp-links span { display: grid; }
  .comp-links strong { font-family: var(--font-display); font-weight: 600; letter-spacing: -.015em; }
  .comp-links em { font-style: normal; font-size: .875rem; color: var(--muted); }
  .comp-links :global(svg) { transition: transform .3s var(--ease); }
  .comp-links a:hover :global(svg) { transform: translateX(3px); }
  @media (max-width: 860px) { .comp-grid { grid-template-columns: 1fr; } }
  @media (max-width: 460px) { .comp-links a { grid-template-columns: 1fr 20px; } .comp-links img { grid-column: 1 / -1; } }
</style>
