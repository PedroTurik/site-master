---
// Responsive photo by name, from src/assets/photos/<name>.(jpg|png|webp).
import { Image } from 'astro:assets';

interface Props {
  name: string;
  alt: string;
  sizes?: string;
  class?: string;
  eager?: boolean;
  position?: string;
}
const { name, alt, sizes = '100vw', class: cls, eager = false, position = '50% 50%' } = Astro.props;
const all = import.meta.glob<{ default: ImageMetadata }>('../assets/photos/*.{jpg,jpeg,png,webp}', { eager: true });
const key = Object.keys(all).find((k) => k.replace(/^.*\//, '').replace(/\.[a-z]+$/, '') === name);
const src = key ? all[key].default : undefined;
if (!src) console.warn(`[Photo] missing: ${name}`);
const widths = src ? [480, 800, 1200, 1600, 2000].filter((w) => w <= src.width).concat(src.width < 2000 ? [src.width] : []) : [];
---
{src ? (
  <Image src={src} alt={alt} widths={[...new Set(widths)]} sizes={sizes} class={cls} loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} style={`object-position:${position}`} />
) : (
  <div class:list={['photo-missing', cls]} role="img" aria-label={alt}></div>
)}

<style>
  .photo-missing { background: linear-gradient(135deg, #2a2d31, #16181b); width: 100%; height: 100%; }
</style>
